---
import PageLayout from "@/layouts/page.astro"
import VentureDetail from "@/components/pages/VentureDetail.astro"
import { getPages, VENTURE_SLUGS, type VentureSlug } from "@/lib/pages"
import { resolveLang, detailPath } from "@/lib/i18n"

export function getStaticPaths() {
  return VENTURE_SLUGS.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug as VentureSlug
const p = getPages(resolveLang(Astro.currentLocale)).ventureDetail[slug]
---

<PageLayout
  title={p.meta.title}
  description={p.meta.description}
  pathId={detailPath("ventures", "id", slug)}
  pathEn={detailPath("ventures", "en", slug)}
>
  <VentureDetail slug={slug} />
</PageLayout>
