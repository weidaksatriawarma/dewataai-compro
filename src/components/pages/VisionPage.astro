---
/**
 * The vision page. Opens on a number rather than a slogan, because the number
 * is the argument: about a million young Balinese are deciding what to be, and
 * right now the default answer is tourism.
 *
 * Same slabs and serif display as the rest of the site.
 */
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowRight01Icon,
  ArrowDown01Icon,
  Tick02Icon,
  Rocket01Icon,
  Building03Icon,
  UserGroupIcon,
  Wallet01Icon,
} from "@hugeicons/core-free-icons"
import PlaceholderImage from "@/components/PlaceholderImage.astro"
import { lines } from "@/lib/site"
import { images } from "@/lib/images"
import { getVision, BALI, baliGenZ } from "@/lib/vision"
import { resolveLang, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const p = getVision(lang)

/* Rounded to the nearest ten thousand and marked approximate: the caveats say
   this is an order of magnitude, so the figure should not be printed as though
   somebody counted heads. */
const nf = new Intl.NumberFormat(lang === "en" ? "en-US" : "id-ID")
const genZ = `~${nf.format(Math.round(baliGenZ / 10_000) * 10_000)}`
const pct = (n: number) => nf.format(Math.round(n * 1000) / 10)

/* Icon order matches the ladder in lib/vision.ts. */
const LADDER_ICONS = [Rocket01Icon, UserGroupIcon, Building03Icon, Wallet01Icon]

const slab = "border-b border-hairline"
const wrap = "mx-auto w-full max-w-7xl px-6 sm:px-10"
const chip =
  "grid size-10 shrink-0 place-items-center rounded-xl border border-hairline bg-muted text-ink"
---

<!-- hero -->
<section class="ink-section relative flex min-h-[74vh] flex-col justify-between overflow-hidden">
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <PlaceholderImage
      src={images.visionHero}
      alt=""
      seed="vision-hero"
      loading="eager"
      class="opacity-[0.38]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(10,10,10,0.42),rgba(10,10,10,0.9))]">
    </div>
  </div>

  <div class={`relative z-10 ${wrap} pt-32 sm:pt-40`}>
    <p class="eyebrow text-white/50">{p.eyebrow}</p>
  </div>

  <div class={`relative z-10 ${wrap} pb-16 sm:pb-24`}>
    <h1 class="t-display max-w-4xl font-serif font-medium text-white">
      {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
    </h1>
    <div class="mt-12 grid gap-8 border-t border-white/12 pt-8 lg:grid-cols-[0.55fr_0.45fr]">
      <p class="max-w-2xl leading-relaxed text-white/65">{p.lead}</p>
      <p class="font-mono text-[0.7rem] leading-relaxed tracking-[0.06em] text-white/40 lg:text-right">
        {p.meta_}
      </p>
    </div>
  </div>

  <span class="pointer-events-none absolute right-6 bottom-8 z-10 text-white/30 sm:right-10">
    <HugeiconsIcon icon={ArrowDown01Icon} size={22} strokeWidth={1.5} />
  </span>
</section>

<!-- 00 the number -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.numbers.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.numbers.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.numbers.lead}</p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden border border-hairline bg-hairline sm:grid-cols-4">
      {
        p.numbers.stats.map((stat) => (
          <div class="bg-background p-6 sm:p-7">
            <div class="font-serif text-3xl text-ink">{stat.value}</div>
            <div class="mt-2 text-sm text-ink">{stat.label}</div>
            <div class="mt-1 font-mono text-[0.66rem] tracking-[0.14em] text-muted-foreground">
              {stat.year}
            </div>
          </div>
        ))
      }
      <div class="bg-ink p-6 text-background sm:p-7">
        <div class="font-serif text-3xl">{genZ}</div>
        <div class="mt-2 text-sm opacity-90">{p.numbers.resultLabel}</div>
        <div class="mt-1 font-mono text-[0.66rem] tracking-[0.14em] opacity-60">
          {pct(BALI.hinduShare)}% × {pct(BALI.genZShare)}%
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.6fr_0.4fr] lg:gap-16">
      <p class="text-sm leading-relaxed text-muted-foreground">{p.numbers.method}</p>
      <div>
        <p class="eyebrow text-muted-foreground">{p.numbers.sourcesLabel}</p>
        <ul class="mt-3 space-y-1.5">
          {
            BALI.sources.map((source) => (
              <li>
                <a
                  href={source.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-xs text-muted-foreground transition-colors hover:text-ink"
                >
                  {source.label}: {source.note}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- the one sentence -->
<section class={`bg-paper py-28 sm:py-44 ${slab}`}>
  <div class={wrap}>
    <p class="t-display text-center font-serif font-medium text-ink">
      {lines(p.statement).map((line) => <span class="t-line">{line}</span>)}
    </p>
  </div>
</section>

<!-- 01 where we are -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.now.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.now.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.now.sub}</p>
    </div>

    <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-3">
      {
        p.now.columns.map((column, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="border-t border-ink pt-6">
            <h3 class="font-serif text-xl text-ink">{column.title}</h3>
            <ul class="mt-5 space-y-3">
              {column.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-hairline text-ink">
                    <HugeiconsIcon icon={Tick02Icon} size={11} strokeWidth={2.2} />
                  </span>
                  <span class="text-sm leading-relaxed text-muted-foreground">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 02 bootstrapped -->
<section class="ink-section py-24 sm:py-36">
  <div class={wrap}>
    <p class="eyebrow text-white/50">{p.bootstrap.label}</p>
    <div class="mt-6 grid gap-8 lg:grid-cols-[0.5fr_0.5fr] lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-white">
        {lines(p.bootstrap.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="self-end leading-relaxed text-white/65">{p.bootstrap.body}</p>
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-9 sm:grid-cols-3">
      {
        p.bootstrap.points.map((point, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`} class="border-t border-white/25 pt-6">
            <h3 class="font-serif text-lg text-white">{point.title}</h3>
            <p class="mt-2.5 leading-relaxed text-white/60">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- band -->
<section class="relative h-[34vh] min-h-[240px] overflow-hidden sm:h-[44vh]">
  <PlaceholderImage src={images.visionBand} alt="" seed="vision-band" class="opacity-70" />
  <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(10,10,10,0.85),rgba(10,10,10,0.25))]">
  </div>
  <div class={`absolute inset-x-0 bottom-0 ${wrap} pb-8`}>
    <p class="font-mono text-[0.7rem] tracking-[0.18em] text-white/70">{p.bali.label}</p>
  </div>
</section>

<!-- 03 bali -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <div class="grid gap-8 lg:grid-cols-[0.5fr_0.5fr] lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.bali.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <div class="space-y-5 self-end">
        {p.bali.body.map((para) => <p class="leading-relaxed text-muted-foreground">{para}</p>)}
      </div>
    </div>

    <ol class="mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        p.bali.ladder.map((rung, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="border-t border-ink pt-6">
            <div class="flex items-center gap-3">
              <span class={chip}>
                <HugeiconsIcon icon={LADDER_ICONS[i]} size={19} strokeWidth={1.7} />
              </span>
              <span class="font-mono text-xs tracking-[0.2em] text-muted-foreground">
                {rung.step}
              </span>
            </div>
            <h3 class="mt-5 font-serif text-lg text-ink">{rung.title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{rung.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-14 max-w-2xl border-t border-hairline pt-6 leading-relaxed text-muted-foreground">
      {p.bali.close}
    </p>
  </div>
</section>

<!-- 04 outlook -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.market.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.market.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.market.sub}</p>
    </div>

    <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-3">
      {
        p.market.items.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`} class="border-t border-hairline pt-6">
            <h3 class="font-serif text-lg leading-snug text-ink">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{item.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 max-w-3xl border-t border-ink pt-6">
      <p class="eyebrow text-muted-foreground">{p.market.caution.title}</p>
      <p class="mt-3 leading-relaxed text-ink">{p.market.caution.body}</p>
    </div>
  </div>
</section>

<!-- cta -->
<section class="ink-section py-24 sm:py-32">
  <div class={wrap}>
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-xl">
        <h2 class="t-heading-sm font-serif font-medium text-white">{p.cta.heading}</h2>
        <p class="mt-4 leading-relaxed text-white/60">{p.cta.body}</p>
      </div>
      <a
        href={path("contact", lang)}
        class="btn-glossy inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
      >
        {p.cta.label}
        <HugeiconsIcon icon={ArrowRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</section>
