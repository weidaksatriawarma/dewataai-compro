---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Location01Icon,
  Target01Icon,
  Shield01Icon,
  SparklesIcon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"

const v = getSite(resolveLang(Astro.currentLocale)).values

const ICONS = {
  local: Location01Icon,
  practical: Target01Icon,
  trust: Shield01Icon,
  craft: SparklesIcon,
} as const
---

<section id="nilai" class="relative overflow-hidden bg-paper py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{v.eyebrow}</p>
      <h2 class="t-heading mt-4 font-serif font-medium text-ink">
        {lines(v.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
    </div>

    <!-- Anyone can claim these four. The second line is what each one gives
         up, which is the part that cannot be copied off a competitor. -->
    <div class="mt-14 grid gap-x-14 gap-y-10 sm:grid-cols-2">
      {
        v.items.map((item, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${80 + i * 70}ms`}
            class="border-t border-ink pt-6"
          >
            <div class="flex items-center justify-between">
              <span class="text-ink">
                <HugeiconsIcon icon={ICONS[item.key]} size={24} strokeWidth={1.2} />
              </span>
              <span class="font-mono text-sm text-muted-foreground tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <h3 class="mt-5 font-serif text-2xl leading-tight text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{item.desc}</p>

            <p class="mt-5 border-t border-hairline pt-4">
              <span class="eyebrow block text-muted-foreground">{v.costLabel}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink/80">{item.cost}</span>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
