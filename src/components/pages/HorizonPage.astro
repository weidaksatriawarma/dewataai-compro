---
/**
 * The forty-year comparison. Same slabs, serif display and figure panels as the
 * other two investor pages, so all three read as one document in three parts.
 *
 * The hero carries the four curves themselves rather than a photograph. The
 * subject of this page is a shape, and a stock image of a rice terrace would be
 * decoration standing where the argument should be.
 *
 * Every figure sits on a light slab on purpose. The --series steps are defined
 * for the light and dark page surfaces; an .ink-section re-pins the palette
 * locally, and a chart drawn inside one would lose its darkest line.
 */
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowRight01Icon,
  ArrowDown01Icon,
  LandPlotIcon,
  AiBrain01Icon,
  CloudServerIcon,
  CafeIcon,
  BalanceScaleIcon,
  Database01Icon,
  HandshakeIcon,
} from "@hugeicons/core-free-icons"
import Figure from "@/components/investor/Figure.astro"
import HistoryChart from "@/components/investor/HistoryChart.astro"
import HorizonChart from "@/components/investor/HorizonChart.tsx"
import SurvivalDumbbell from "@/components/investor/SurvivalDumbbell.astro"
import DrawdownBars from "@/components/investor/DrawdownBars.astro"
import ControlMatrix from "@/components/investor/ControlMatrix.astro"
import { lines } from "@/lib/site"
import { resolveLang, path } from "@/lib/i18n"
import {
  ASSETS,
  INDEX,
  HORIZON,
  BASE_INDEX,
  SURVIVAL,
  MAX_DRAWDOWN,
  RECOVERY_YEARS,
  SOURCES,
  HISTORY_KEYS,
  HISTORY_YEARS,
  HISTORY_CLOSE,
  HISTORY_FX,
  HISTORY_SPAN,
  HISTORY_IN_RUPIAH,
  historyMultiple,
  historyCagr,
  historyNativeCagr,
  weighted,
  cagr,
  multiple,
  percent,
  rateRow,
  sourceFigure,
  getHorizon,
} from "@/lib/horizon"

const lang = resolveLang(Astro.currentLocale)
const locale = lang === "en" ? "en-US" : "id-ID"
const p = getHorizon(lang)
const fig = p.figure
const A = p.assets
const h = p.history

/* One per item in p.answer.items, in the same order. */
const ANSWER_ICONS = [
  LandPlotIcon,
  AiBrain01Icon,
  CloudServerIcon,
  BalanceScaleIcon,
  CafeIcon,
  Database01Icon,
  HandshakeIcon,
]

const nf = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 })
const nf2 = new Intl.NumberFormat(locale, {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
})
const times = (v: number) => `${multiple(v, lang)}x`

/* A close carries its own currency mark, because two of the three series are
   quoted in dollars and a bare number in that column would read as rupiah. */
const close = (k: (typeof HISTORY_KEYS)[number], v: number) =>
  HISTORY_IN_RUPIAH[k] ? nf2.format(v) : `US$${nf2.format(v)}`

/* The measured table prints the closes rather than the rebased index: the
   index is what the chart draws, the close is what a reader can verify against
   a source that is not this page. */
const historyRows = HISTORY_YEARS.map((year, i) => [
  String(year),
  ...HISTORY_KEYS.map((k) => close(k, HISTORY_CLOSE[k][i])),
  `Rp${nf.format(HISTORY_FX[i])}`,
])

const historySummary = HISTORY_KEYS.map((k) => [
  A[k],
  close(k, HISTORY_CLOSE[k][0]),
  close(k, HISTORY_CLOSE[k][HISTORY_SPAN]),
  times(historyMultiple(k) * BASE_INDEX),
  `${percent(historyCagr(k), lang)}%`,
  HISTORY_IN_RUPIAH[k]
    ? h.chart.sameCurrency
    : `${percent(historyNativeCagr(k), lang)}%`,
])

/* Every table below is derived from the same constants the charts read, so a
   figure and its table can never disagree. */
const curveRows = [0, 5, 10, 15, 20, 25, 30, 35, 40].map((y) => [
  String(y),
  ...ASSETS.map((k) => nf.format(INDEX[k][y])),
])

const haircutRows = ASSETS.map((k) => [
  A[k],
  times(INDEX[k][HORIZON]),
  times(weighted(k, HORIZON)),
  `${Math.round(SURVIVAL[k] * 100)}%`,
  `${percent(cagr(weighted(k, HORIZON), HORIZON), lang)}%`,
])

const drawdownRows = ASSETS.map((k) => [
  A[k],
  `${Math.round(MAX_DRAWDOWN[k] * 100)}%`,
  `${RECOVERY_YEARS[k]} ${p.drawdown.chart.yearsUnit}`,
  p.drawdown.notes[k],
])

const assumptionRows = ASSETS.map((k) => [
  A[k],
  rateRow(k, lang),
  `${Math.round(SURVIVAL[k] * 100)}%`,
  `${Math.round(MAX_DRAWDOWN[k] * 100)}%`,
  `${percent(cagr(INDEX[k][HORIZON], HORIZON), lang)}%`,
])

/* Hero backdrop: the four curves at full bleed, log scaled, no chrome. */
const HW = 1200
const HH = 560
const hLo = Math.log10(BASE_INDEX)
const hHi = Math.log10(Math.max(...ASSETS.map((k) => INDEX[k][HORIZON])))
const heroPath = (k: (typeof ASSETS)[number]) =>
  INDEX[k]
    .map((v, y) => {
      const x = (y / HORIZON) * HW
      const yy = HH - ((Math.log10(v) - hLo) / (hHi - hLo)) * (HH - 40)
      return `${y === 0 ? "M" : "L"}${x.toFixed(1)} ${yy.toFixed(1)}`
    })
    .join(" ")
const HERO_DASH: Record<string, string> = {
  software: "",
  bitcoin: "14 8",
  stocks: "6 6",
  sp500: "20 8 3 8",
  gold: "10 5 2 5",
  hotel: "3 8",
  land: "22 6 4 6",
}

const slab = "border-b border-hairline"
const wrap = "mx-auto w-full max-w-7xl px-6 sm:px-10"
const chipDark =
  "grid size-10 shrink-0 place-items-center rounded-xl border border-white/15 bg-white/[0.06] text-white"
---

<!-- hero: the four curves, full bleed, no chrome -->
<section
  class="ink-section relative flex min-h-[78vh] flex-col justify-between overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-[14%] bottom-[26%] z-0"
    aria-hidden="true"
  >
    <svg
      viewBox={`0 0 ${HW} ${HH}`}
      preserveAspectRatio="none"
      class="h-full w-full [mask-image:linear-gradient(to_bottom,transparent,#000_30%,#000_74%,transparent)]"
    >
      {
        ASSETS.map((k, i) => (
          <path
            d={heroPath(k)}
            fill="none"
            stroke="#ffffff"
            stroke-opacity={Math.max(0.1, 0.42 - i * 0.035)}
            stroke-width={i === 0 ? 2.25 : 1.5}
            stroke-dasharray={HERO_DASH[k] || undefined}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </svg>
  </div>
  {
    /* The curves are the backdrop, so they lose to the type wherever the two
      meet. Without this scrim the dashed lines run straight through the lead
      paragraph. */
  }
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[46%] bg-[linear-gradient(to_top,rgba(10,10,10,0.97),rgba(10,10,10,0.82)_38%,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="grid-overlay pointer-events-none absolute inset-0 z-0 [mask-image:linear-gradient(to_bottom,#000_10%,transparent_80%)] opacity-[0.13]"
    aria-hidden="true"
  >
  </div>

  <div class={`relative z-10 ${wrap} pt-32 sm:pt-40`}>
    <p class="eyebrow text-white/50">{p.eyebrow}</p>
  </div>

  <div class={`relative z-10 ${wrap} pb-16 sm:pb-24`}>
    <h1 class="t-display max-w-4xl font-serif font-medium text-white">
      {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
    </h1>
    <div
      class="mt-12 grid gap-8 border-t border-white/12 pt-8 lg:grid-cols-[0.55fr_0.45fr]"
    >
      <p class="max-w-2xl leading-relaxed text-white/65">{p.lead}</p>
      <p
        class="font-mono text-[0.7rem] leading-relaxed tracking-[0.06em] text-white/40 lg:text-right"
      >
        {p.meta_}
      </p>
    </div>
  </div>

  <span
    class="pointer-events-none absolute right-6 bottom-8 z-10 text-white/30 sm:right-10"
  >
    <HugeiconsIcon icon={ArrowDown01Icon} size={22} strokeWidth={1.5} />
  </span>
</section>

<!-- the one sentence -->
<section class={`bg-paper py-28 sm:py-44 ${slab}`}>
  <div class={wrap}>
    <p class="t-display text-center font-serif font-medium text-ink">
      {lines(p.statement).map((line) => <span class="t-line">{line}</span>)}
    </p>
  </div>
</section>

<!-- 01 the question -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.why.label}</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-[0.45fr_0.55fr] lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.why.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <div class="max-w-2xl space-y-5 self-end">
        {
          p.why.body.map((para) => (
            <p class="leading-relaxed text-muted-foreground">{para}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- 02 twenty measured years -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{h.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(h.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{h.sub}</p>
    </div>

    {
      /* The one figure on these pages stamped DATA rather than MODEL. Its table
        prints the raw closes rather than the rebased index on purpose: the
        index is what the chart shows, but the close is what a reader can look
        up somewhere that is not this website. */
    }
    <div class="mt-14">
      <Figure
        index="05"
        prefix={fig.prefix}
        title={h.chart.title}
        unit={h.chart.unit}
        status={fig.dataStatus}
        statusTitle={fig.dataStatusTitle}
        tableLabel={fig.table}
        headers={h.chart.tableHeaders}
        rows={historyRows}
      >
        <HistoryChart assets={A} labels={h.chart} lang={lang} />
      </Figure>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[0.55fr_0.45fr] lg:gap-16">
      <div class="max-w-2xl space-y-5">
        {
          h.lead.map((para) => (
            <p class="leading-relaxed text-muted-foreground">{para}</p>
          ))
        }
      </div>
      <div class="self-start border-t border-ink pt-6">
        <p class="eyebrow text-muted-foreground">{h.rupiah.label}</p>
        <p class="mt-3 leading-relaxed text-ink">{h.rupiah.body}</p>
      </div>
    </div>

    <div class="mt-14 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <thead>
          <tr>
            {
              h.chart.summaryHeaders.map((label) => (
                <th
                  scope="col"
                  class="border-b border-ink py-3 pr-6 font-mono text-[0.66rem] font-normal tracking-[0.14em] text-muted-foreground"
                >
                  {label}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            historySummary.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  <td
                    class:list={[
                      "border-b border-hairline py-3.5 pr-6 text-sm",
                      i === 0
                        ? "text-ink"
                        : "font-mono text-muted-foreground tabular-nums",
                    ]}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:gap-12">
      {
        [h.dividend, h.land, h.asOf].map((note) => (
          <div class="border-t border-hairline pt-6">
            <p class="eyebrow text-muted-foreground">{note.label}</p>
            <p class="mt-3 leading-relaxed text-muted-foreground">
              {note.body}
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-14 max-w-3xl leading-relaxed text-ink">{h.after}</p>
  </div>
</section>

<!-- 03 the raw curves -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.curve.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {
          lines(p.curve.heading).map((line) => (
            <span class="t-line">{line}</span>
          ))
        }
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.curve.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="06"
        prefix={fig.prefix}
        title={p.curve.chart.title}
        unit={p.curve.chart.unit}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.curve.chart.tableHeaders}
        rows={curveRows}
        fluid
      >
        <HorizonChart
          client:visible
          lang={lang}
          assets={A}
          labels={p.curve.chart}
        />
      </Figure>
    </div>

    {
      /* The panel figure already prints each asset's multiple and its rate, so a
        row of stat tiles underneath would be the same ten numbers twice. */
    }
    <p class="mt-12 max-w-3xl leading-relaxed text-muted-foreground">
      {p.curve.after}
    </p>
  </div>
</section>

<!-- 04 the survival haircut -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.haircut.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {
          lines(p.haircut.heading).map((line) => (
            <span class="t-line">{line}</span>
          ))
        }
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.haircut.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="07"
        prefix={fig.prefix}
        title={p.haircut.chart.title}
        unit={p.haircut.chart.unit}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.haircut.chart.tableHeaders}
        rows={haircutRows}
      >
        <SurvivalDumbbell assets={A} labels={p.haircut.chart} lang={lang} />
      </Figure>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-2 lg:gap-14">
      <div class="border-t border-ink pt-6">
        <p class="eyebrow text-muted-foreground">{p.haircut.flip.label}</p>
        <p class="mt-3 leading-relaxed text-ink">{p.haircut.flip.body}</p>
      </div>
      <div class="border-t border-hairline pt-6">
        <p class="eyebrow text-muted-foreground">{p.haircut.cafe.label}</p>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          {p.haircut.cafe.body}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 05 the worst year -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.drawdown.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {
          lines(p.drawdown.heading).map((line) => (
            <span class="t-line">{line}</span>
          ))
        }
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.drawdown.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="08"
        prefix={fig.prefix}
        title={p.drawdown.chart.title}
        unit={p.drawdown.chart.unit}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.drawdown.chart.tableHeaders}
        rows={drawdownRows}
      >
        <DrawdownBars
          assets={A}
          notes={p.drawdown.notes}
          labels={p.drawdown.chart}
        />
      </Figure>
    </div>

    <p class="mt-10 max-w-3xl leading-relaxed text-muted-foreground">
      {p.drawdown.after}
    </p>
  </div>
</section>

<!-- 06 what you can steer -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.control.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {
          lines(p.control.heading).map((line) => (
            <span class="t-line">{line}</span>
          ))
        }
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.control.sub}</p>
    </div>

    {
      /* No table disclosure on this one: the figure already is the table, and
        a second copy of it underneath would be duplication, not relief. */
    }
    <figure class="relative mt-14 border border-hairline bg-background">
      <span class="tick tick-tl" aria-hidden="true"></span>
      <span class="tick tick-tr" aria-hidden="true"></span>
      <span class="tick tick-bl" aria-hidden="true"></span>
      <span class="tick tick-br" aria-hidden="true"></span>

      <figcaption
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-hairline px-5 py-4 sm:px-7"
      >
        <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span
            class="font-mono text-[0.68rem] tracking-[0.18em] text-muted-foreground"
          >
            {fig.prefix} 09
          </span>
          <span class="text-sm font-medium text-ink"
            >{p.control.chart.title}</span
          >
          <span class="font-mono text-[0.68rem] text-muted-foreground">
            ({p.control.chart.unit})
          </span>
        </span>
        <span
          title={fig.statusTitle}
          class="font-mono text-[0.62rem] tracking-[0.22em] text-muted-foreground"
        >
          {fig.status}
        </span>
      </figcaption>

      <div class="overflow-x-auto px-5 py-7 sm:px-7 sm:py-9">
        <ControlMatrix
          assets={A}
          rows={p.control.rows}
          measureHeader={p.control.chart.tableHeaders[0]}
        />
      </div>
    </figure>

    <p class="mt-8 max-w-3xl text-xs leading-relaxed text-muted-foreground">
      {p.control.scaleNote}
    </p>
  </div>
</section>

<!-- 07 the answer -->
<section class="ink-section py-24 sm:py-36">
  <div class={wrap}>
    <p class="eyebrow text-white/50">{p.answer.label}</p>
    <h2 class="t-heading mt-6 max-w-3xl font-serif font-medium text-white">
      {
        lines(p.answer.heading).map((line) => (
          <span class="t-line">{line}</span>
        ))
      }
    </h2>

    <div class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-2">
      {
        p.answer.items.map((item, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
            class="border-t border-white/25 pt-6"
          >
            <span class={chipDark}>
              <HugeiconsIcon
                icon={ANSWER_ICONS[i]}
                size={19}
                strokeWidth={1.7}
              />
            </span>
            <h3 class="mt-5 font-serif text-xl leading-snug text-white">
              {item.title}
            </h3>
            <p class="mt-3 max-w-xl leading-relaxed text-white/60">
              {item.body}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 max-w-3xl border-t border-white/15 pt-6">
      <p class="eyebrow text-white/50">{p.answer.close.label}</p>
      <p class="mt-3 leading-relaxed text-white/75">{p.answer.close.body}</p>
      <a
        href={path("thesis", lang)}
        class="link-underline mt-5 inline-flex items-center gap-2 text-sm font-medium text-white"
      >
        {p.answer.close.link}
        <HugeiconsIcon icon={ArrowRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</section>

<!-- 08 assumptions -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.assumptions.label}</p>
    <div
      class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16"
    >
      <h2 class="t-heading font-serif font-medium text-ink">
        {
          lines(p.assumptions.heading).map((line) => (
            <span class="t-line">{line}</span>
          ))
        }
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.assumptions.sub}</p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-left">
        <thead>
          <tr>
            {
              p.assumptions.tableHeaders.map((h) => (
                <th
                  scope="col"
                  class="border-b border-ink py-3 pr-6 font-mono text-[0.66rem] font-normal tracking-[0.14em] text-muted-foreground"
                >
                  {h}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            assumptionRows.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  <td
                    class:list={[
                      "border-b border-hairline py-3.5 pr-6 text-sm",
                      i === 0
                        ? "text-ink"
                        : "font-mono text-muted-foreground tabular-nums",
                    ]}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-relaxed text-muted-foreground">
      {p.assumptions.note}
    </p>

    {
      /* The second table is the point of this section. Every figure the model is
        calibrated against, the institution that published it, and a link, so a
        reader can check an input rather than take the curve on faith. */
    }
    <p class="eyebrow mt-20 text-muted-foreground">
      {p.assumptions.sourcesLabel}
    </p>
