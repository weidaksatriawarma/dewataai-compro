---
import { getSite } from "@/lib/site"
import { resolveLang, getUI, localeHref } from "@/lib/i18n"

interface Props {
  /** This page's path in each locale, so the switcher stays on the same page. */
  pathId?: string
  pathEn?: string
}

const { pathId = "/", pathEn = "/en/" } = Astro.props
const lang = resolveLang(Astro.currentLocale)
const t = getSite(lang)
const ui = getUI(lang)
const STAR =
  "M16 3 L18 12.6 L24.5 6.6 L20.5 14.1 L30 16 L20.5 17.9 L24.5 25.4 L18 19.4 L16 29 L14 19.4 L7.5 25.4 L11.5 17.9 L2 16 L11.5 14.1 L7.5 6.6 L14 12.6 Z"

const langs = [
  { code: "id", label: "ID", href: pathId },
  { code: "en", label: "EN", href: pathEn },
] as const

const homeHref = localeHref(lang)
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div class="nav-bar border-b border-transparent">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
      <!-- wordmark -->
      <a href={homeHref} class="brand group inline-flex items-center gap-2.5" aria-label={ui.homeAria}>
        <span class="grid size-8 place-items-center rounded-[10px] bg-ink text-background shadow-[0_2px_10px_-3px_rgba(0,0,0,0.4)] transition-transform duration-500 group-hover:rotate-[18deg]">
          <svg viewBox="0 0 32 32" class="size-[18px]" fill="currentColor" aria-hidden="true">
            <path d={STAR}></path>
          </svg>
        </span>
        <span class="text-[1.075rem] leading-none text-ink">
          <span class="font-sans font-semibold tracking-tight">Dewata</span><span
            class="ml-1 font-serif font-medium italic">AI</span
          >
        </span>
      </a>

      <!-- desktop links -->
      <div class="hidden items-center gap-6 md:flex lg:gap-9">
        {
          t.nav.links.map((l) => (
            <a
              href={l.href}
              class="link-underline text-sm font-medium text-ink/70 transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2.5">
        <!-- language switcher -->
        <div
          class="flex items-center rounded-full border border-hairline p-0.5 text-xs font-medium"
          role="group"
          aria-label={ui.langSwitch}
        >
          {
            langs.map((l) => (
              <a
                href={l.href}
                aria-current={lang === l.code ? "true" : undefined}
                class:list={[
                  "rounded-full px-2.5 py-1 transition-colors",
                  lang === l.code
                    ? "bg-ink text-background"
                    : "text-muted-foreground hover:text-ink",
                ]}
              >
                {l.label}
              </a>
            ))
          }
        </div>

        <!-- theme toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label={ui.themeToggle}
          class="theme-toggle grid size-10 place-items-center rounded-full border border-hairline bg-background/60 text-ink transition-colors hover:bg-muted"
        >
          <svg class="icon-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href={t.nav.cta.href}
          class="btn-glossy hidden h-10 items-center gap-1.5 rounded-full px-5 text-sm font-medium sm:inline-flex"
        >
          {t.nav.cta.label}
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8"></path>
          </svg>
        </a>

        <button
          id="nav-toggle"
          type="button"
          aria-label={ui.openMenu}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-open={ui.openMenu}
          data-close={ui.closeMenu}
          class="nav-toggle grid size-10 place-items-center rounded-full border border-hairline bg-background/60 text-ink transition-colors hover:bg-muted md:hidden"
        >
          <svg class="icon-menu size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 9h16M4 15h16"></path>
          </svg>
          <svg class="icon-close size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- mobile panel -->
    <div id="mobile-menu" class="mobile-panel grid overflow-hidden md:hidden" aria-hidden="true" inert>
      <div class="min-h-0">
        <div class="flex flex-col gap-1 px-5 pb-6 pt-2 sm:px-8">
          {
            t.nav.links.map((l) => (
              <a
                href={l.href}
                class="nav-link flex items-center justify-between border-b border-hairline py-3.5 font-serif text-xl text-ink"
              >
                {l.label}
                <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8"></path>
                </svg>
              </a>
            ))
          }
          <a
            href={t.nav.cta.href}
            class="nav-link btn-glossy mt-4 inline-flex h-12 items-center justify-center gap-2 rounded-full px-6 text-sm font-medium"
          >
            {t.nav.cta.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-bar {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }
  .nav-bar.is-scrolled {
    border-bottom-color: var(--hairline);
    /* solid translucent (no backdrop-filter) so the sticky bar never repaints a blur on scroll */
    background-color: color-mix(in oklch, var(--background) 92%, transparent);
  }
  .nav-toggle .icon-close {
    display: none;
  }
  .nav-toggle.is-open .icon-menu {
    display: none;
  }
  .nav-toggle.is-open .icon-close {
    display: block;
  }
  .mobile-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .mobile-panel.is-open {
    grid-template-rows: 1fr;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".nav-bar")
  const toggle = document.getElementById("nav-toggle")
  const panel = document.getElementById("mobile-menu")

  if (bar) {
    const onScroll = () => bar.classList.toggle("is-scrolled", window.scrollY > 12)
    onScroll()
    window.addEventListener("scroll", onScroll, { passive: true })
  }

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.classList.toggle("is-open", open)
      panel.classList.toggle("is-open", open)
      toggle.setAttribute("aria-expanded", String(open))
      toggle.setAttribute(
        "aria-label",
        open ? toggle.dataset.close ?? "" : toggle.dataset.open ?? "",
      )
      panel.setAttribute("aria-hidden", String(!open))
      if (open) panel.removeAttribute("inert")
      else panel.setAttribute("inert", "")
      document.body.style.overflow = open ? "hidden" : ""
    }
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    )
    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)))
  }

  // Theme toggle (light/dark). Initial class is set by the no-flash script in <head>.
  const themeToggle = document.getElementById("theme-toggle")
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark")
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light")
      } catch (e) {}
      const meta = document.getElementById("theme-color-meta")
      if (meta) meta.setAttribute("content", isDark ? "#1a1a1a" : "#ffffff")
    })
  }
</script>
