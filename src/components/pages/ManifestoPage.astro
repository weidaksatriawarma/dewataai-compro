---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import { getPages } from "@/lib/pages"
import { getSite } from "@/lib/site"
import { resolveLang, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const p = getPages(lang).manifesto
const site = getSite(lang)
---

<PageHero eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />

<section class="bg-paper py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    <ol class="space-y-0">
      {
        p.points.map((point, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
            class="grid gap-4 border-t border-hairline py-9 sm:grid-cols-[auto_1fr] sm:gap-8"
          >
            <span class="font-mono text-sm text-muted-foreground tabular-nums">{point.index}</span>
            <div>
              <h2 class="font-serif text-xl leading-snug text-ink sm:text-2xl">{point.title}</h2>
              <p class="mt-3 leading-relaxed text-muted-foreground">{point.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="ink-section relative overflow-hidden py-20 sm:py-24">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="glow absolute top-[-30%] left-1/2 h-[420px] w-[760px] max-w-[120vw] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(255,255,255,0.07),transparent)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
    <p data-reveal class="t-heading-sm font-serif text-white">{p.closing.heading}</p>
    <a
      data-reveal
      style="--reveal-delay:100ms"
      href={path("contact", lang)}
      class="btn-glossy mt-8 inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
    >
      {p.closing.cta}
      <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
    </a>
    <p data-reveal style="--reveal-delay:160ms" class="mt-8 font-mono text-xs text-white/40">
      {site.brand.legal.legalName}
    </p>
  </div>
</section>
