---
/** Index for both /jurnal (post) and /pers (pressRelease). */
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import { getSite } from "@/lib/site"
import { getPages } from "@/lib/pages"
import { resolveLang, getUI, detailPath } from "@/lib/i18n"
import { listArticles, formatDate, imageUrl } from "@/lib/cms"

interface Props {
  kind: "post" | "pressRelease"
}

const { kind } = Astro.props
const lang = resolveLang(Astro.currentLocale)
const ui = getUI(lang)
const site = getSite(lang)
const pages = getPages(lang)
const p = kind === "post" ? pages.journal : pages.press
const routeKey = kind === "post" ? "journal" : "press"

const articles = await listArticles(kind, lang)
const isPress = kind === "pressRelease"
---

<PageHero eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />

<section class="bg-paper py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    {
      articles.length === 0 ? (
        <p
          data-reveal
          class="rounded-3xl border border-dashed border-ink/20 bg-background px-6 py-14 text-center text-muted-foreground"
        >
          {ui.empty}
        </p>
      ) : (
        <ul>
          {articles.map((article, i) => {
            const cover = imageUrl(article.coverImage, 640)
            return (
              <li data-reveal style={`--reveal-delay:${i * 60}ms`} class="border-t border-hairline">
                <a
                  href={detailPath(routeKey, lang, article.slug)}
                  class="group grid gap-5 py-8 sm:grid-cols-[1fr_auto] sm:gap-10"
                >
                  <div>
                    <p class="font-mono text-xs text-muted-foreground">
                      {isPress && article.dateline ? `${article.dateline} · ` : ""}
                      {formatDate(article.publishedAt, lang)}
                    </p>
                    <h2 class="mt-3 font-serif text-2xl leading-snug text-ink sm:text-3xl">
                      {article.title}
                    </h2>
                    <p class="mt-3 max-w-xl leading-relaxed text-muted-foreground">
                      {article.excerpt}
                    </p>
                    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
                      {ui.readMore}
                      <HugeiconsIcon icon={ArrowUpRight01Icon} size={14} strokeWidth={2} />
                    </span>
                  </div>

                  {cover && (
                    <img
                      src={cover}
                      alt={article.coverImage?.alt ?? ""}
                      loading="lazy"
                      class="order-first aspect-[16/10] w-full rounded-2xl border border-hairline object-cover sm:order-last sm:h-32 sm:w-48"
                    />
                  )}
                </a>
              </li>
            )
          })}
        </ul>
      )
    }

    {
      isPress && (
        <div data-reveal class="mt-12 rounded-3xl border border-hairline bg-background p-6 sm:p-8">
          <p class="eyebrow text-muted-foreground">{pages.press.contactLabel}</p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            <a href={`mailto:${site.brand.email}`} class="link-underline font-medium text-ink">
              {site.brand.email}
            </a>
          </p>
          <p class="mt-1 text-sm text-muted-foreground">{site.brand.legal.legalName}</p>
        </div>
      )
    }
  </div>
</section>
