---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  BrainIcon,
  SourceCodeIcon,
  RoboticIcon,
  Atom01Icon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"

const p = getSite(resolveLang(Astro.currentLocale)).pillars

const ICONS = {
  brain: BrainIcon,
  code: SourceCodeIcon,
  automation: RoboticIcon,
  research: Atom01Icon,
} as const
---

<section id="kapabilitas" class="relative overflow-hidden bg-background py-24 sm:py-32">
  <!-- backdrop texture -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 dot-overlay opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_50%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- header -->
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{p.eyebrow}</p>
      <h2
        class="t-heading mt-4 font-serif font-medium text-ink"
      >
        {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg text-balance">
        {p.sub}
      </p>
    </div>

    <!-- Ruled entries rather than cards: the right-hand column carries where
         each capability actually runs, which is what the sub-headline claims. -->
    <div class="mt-12 border-t border-ink sm:mt-16">
      {
        p.items.map((item, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${(i + 1) * 70}ms`}
            class="cap-row grid grid-cols-[2.5rem_1fr] items-start gap-x-5 gap-y-3 border-b border-hairline py-7 pr-1 sm:grid-cols-[3rem_auto_1fr_auto] sm:items-center sm:gap-x-8 sm:pr-6"
          >
            <span class="font-mono text-sm text-muted-foreground tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>

            <span class="hidden text-ink sm:block">
              <HugeiconsIcon
                icon={ICONS[item.key as keyof typeof ICONS]}
                size={26}
                strokeWidth={1.2}
              />
            </span>

            <span class="min-w-0">
              <h3 class="font-serif text-2xl leading-tight text-ink sm:text-[1.75rem]">
                {item.title}
              </h3>
              <p class="mt-1.5 max-w-md leading-relaxed text-muted-foreground">{item.desc}</p>
            </span>

            <span class="col-start-2 sm:col-start-auto sm:text-right">
              <span class="eyebrow block text-muted-foreground">{p.proofLabel}</span>
              <span class="mt-1 block font-mono text-sm text-ink">{item.proof}</span>
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cap-row {
    transition:
      background-color 0.3s ease,
      padding-left 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .cap-row:hover {
    background-color: color-mix(in oklch, var(--foreground) 3.5%, transparent);
    padding-left: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cap-row {
      transition: none;
    }
  }
</style>
