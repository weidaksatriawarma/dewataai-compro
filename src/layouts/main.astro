---
import { Font } from "astro:assets"
import "@/styles/global.css"
import { resolveLang, getUI } from "@/lib/i18n"
import { getSite } from "@/lib/site"

interface Props {
  title?: string
  description?: string
  /** Path of this page in each locale, so canonical + hreflang stay correct. */
  pathId?: string
  pathEn?: string
  /** Share card image, root-relative. Articles pass their own cover here. */
  ogImage?: string
}

const lang = resolveLang(Astro.currentLocale)
const t = getSite(lang)
const ui = getUI(lang)
const {
  title = t.meta.title,
  description = t.meta.description,
  pathId = "/",
  pathEn = "/en/",
  ogImage = "/og.png",
} = Astro.props

const urlId = new URL(pathId, Astro.site).href
const urlEn = new URL(pathEn, Astro.site).href
const canonical = lang === "en" ? urlEn : urlId

// Scrapers reject relative image paths, so this has to be absolute.
const ogImageUrl = new URL(ogImage, Astro.site).href
const usingDefaultCard = ogImage === "/og.png"

/** Organization schema: legal entity, registered address and NIB (AHU / OSS records). */
const legal = t.brand.legal
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: t.brand.name,
  legalName: `${legal.legalName} (${legal.legalForm})`,
  url: urlId,
  email: t.brand.email,
  description: t.meta.description,
  address: {
    "@type": "PostalAddress",
    streetAddress: `${legal.address.street}, ${legal.address.village}, ${legal.address.district}`,
    addressLocality: legal.address.city,
    addressRegion: legal.address.region,
    addressCountry: legal.address.country,
  },
  identifier: {
    "@type": "PropertyValue",
    name: "NIB",
    value: legal.nib,
  },
  subjectOf: {
    "@type": "CreativeWork",
    name: "Sertifikat Pendirian AHU",
    url: legal.ahuUrl,
  },
  subOrganization: t.ventures.items.map((v) => ({
    "@type": "Organization",
    name: v.name,
    url: v.url,
  })),
  founder: [
    { "@type": "Person", name: "Anak Agung Gde Weida Ksatriawarma", jobTitle: "Founder & CEO" },
    { "@type": "Person", name: "Anak Agung Gde Wijaya Ksatriawarma", jobTitle: "Co-founder" },
  ],
  slogan: t.brand.tagline,
  foundingDate: "2026",
  foundingLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: legal.address.city,
      addressRegion: legal.address.region,
      addressCountry: legal.address.country,
    },
  },
  areaServed: { "@type": "Country", name: "Indonesia" },
  /* What the group is actually about, in the terms an answer engine matches
     against. Kept factual and narrow rather than a keyword list. */
  knowsAbout: [
    "AI software for Indonesian small business",
    "Chat-based bookkeeping",
    "SAK EMKM financial reporting",
    "Direct booking engines for villas",
    "Bali hospitality technology",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "business",
    email: t.brand.email,
    areaServed: "ID",
    availableLanguage: ["id", "en"],
  },
}

/* Names the site itself, so an engine can separate the brand from the legal
   entity when it cites us. */
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t.brand.name,
  alternateName: legal.legalName,
  url: urlId,
  inLanguage: lang,
  publisher: { "@type": "Organization", name: t.brand.name, url: urlId },
}

/* The homepage carries a real FAQ, so it gets FAQPage markup. Every other page
   would be claiming a section it does not have. */
const isHome = pathId === "/"
const faqSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: t.faq.items.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    }
  : null
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* .ico carries 16/32/48 for tabs, bookmarks and Google's search result
        favicon; the PNG serves browsers that prefer a higher-resolution
        bitmap; apple-touch-icon is what iOS uses when a page is saved to the
        home screen; the manifest supplies the Android and PWA icons. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" id="theme-color-meta" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={urlId} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlId} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dewata AI" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {/* Dimensions let Facebook, LinkedIn and WhatsApp lay the card out on
        first scrape instead of showing nothing until they fetch the file. */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    {usingDefaultCard && <meta property="og:image:width" content="1200" />}
    {usingDefaultCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={usingDefaultCard ? "Dewata AI" : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(siteSchema)}
    />
    {
      faqSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
      )
    }
    {/* Plain-language brief for answer engines, kept in sync with the site. */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    {/* No-flash theme init: applies .dark before first paint */}
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem("theme")
          const dark =
            stored === "dark" ||
            (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
          document.documentElement.classList.toggle("dark", dark)
          const meta = document.getElementById("theme-color-meta")
          if (meta) meta.setAttribute("content", dark ? "#1a1a1a" : "#ffffff")
        } catch (e) {}
      })()
    </script>

    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-jetbrains" />
    <Font cssVariable="--font-montserrat" />
  </head>
  <body class="overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-background"
    >
      {ui.skipToContent}
    </a>
    <slot />
  </body>
</html>
