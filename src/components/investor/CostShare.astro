---
/**
 * Three 100% stacked columns on one shared four-bucket schema, which is the
 * only reason the columns can be compared at all.
 *
 * The ramp is sequential (one hue, light to dark) because the buckets run from
 * "money that leaves first" to "money that stays", and the darkest step lands
 * on the bucket a reader actually cares about. A 2px surface gap separates
 * segments so adjacent steps never blend, and every segment carries its own
 * number, so the legend is a convenience rather than the only key.
 */
export interface Column {
  label: string
  segments: readonly { key: string; label: string; value: number }[]
}

interface Props {
  columns: readonly Column[]
  order: readonly string[]
}

const { columns, order } = Astro.props

const W = 720
const H = 330
const TOP = 12
const PLOT = 250
const COL_W = 128
const gap = (W - columns.length * COL_W) / (columns.length + 1)

/* The ramp is monotonic in both themes, but it has to invert between them: on
   a dark page the darkest step would otherwise disappear into the surface.
   Steps and their label colours are therefore CSS classes, not inline fills. */
---

<div>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="">
    {
      columns.map((col, ci) => {
        const x = gap + ci * (COL_W + gap)
        let cursor = TOP + PLOT
        return (
          <g>
            {order.map((key, si) => {
              const seg = col.segments.find((s) => s.key === key)!
              const h = (seg.value / 100) * PLOT
              cursor -= h
              const y = cursor
              cursor -= 2 /* surface gap between segments */
              return (
                <g>
                  <title>{`${col.label} · ${seg.label}: ${seg.value}%`}</title>
                  <rect
                    x={x}
                    y={y}
                    width={COL_W}
                    height={Math.max(h - 2, 1)}
                    class={`s${si}`}
                  />
                  {h > 20 && (
                    <text
                      x={x + COL_W / 2}
                      y={y + h / 2 + 5}
                      text-anchor="middle"
                      class={`seg-lab l${si}`}
                    >
                      {seg.value}
                    </text>
                  )}
                </g>
              )
            })}
            <text x={x + COL_W / 2} y={TOP + PLOT + 28} text-anchor="middle" class="col-lab">
              {col.label}
            </text>
          </g>
        )
      })
    }
  </svg>

  <ul class="mt-7 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
    {
      order.map((key, i) => {
        const seg = columns[0].segments.find((s) => s.key === key)!
        return (
          <li class="flex items-center gap-2.5">
            <span class={`swatch sw${i} h-2.5 w-5 shrink-0`} />
            <span class="text-xs text-muted-foreground">{seg.label}</span>
          </li>
        )
      })
    }
  </ul>
</div>

<style>
  .s0 { fill: #d4d4d4; }
  .s1 { fill: #a3a3a3; }
  .s2 { fill: #6b6b6b; }
  .s3 { fill: #171717; }
  .sw0 { background: #d4d4d4; }
  .sw1 { background: #a3a3a3; }
  .sw2 { background: #6b6b6b; }
  .sw3 { background: #171717; }
  .seg-lab {
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .l0, .l1 { fill: #171717; }
  .l2, .l3 { fill: #ffffff; }

  :global(.dark) .s0 { fill: #3f3f3f; }
  :global(.dark) .s1 { fill: #6b6b6b; }
  :global(.dark) .s2 { fill: #a8a8a8; }
  :global(.dark) .s3 { fill: #f2f2f2; }
  :global(.dark) .sw0 { background: #3f3f3f; }
  :global(.dark) .sw1 { background: #6b6b6b; }
  :global(.dark) .sw2 { background: #a8a8a8; }
  :global(.dark) .sw3 { background: #f2f2f2; }
  :global(.dark) .l0, :global(.dark) .l1 { fill: #f2f2f2; }
  :global(.dark) .l2, :global(.dark) .l3 { fill: #171717; }
  .col-lab {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }
</style>
