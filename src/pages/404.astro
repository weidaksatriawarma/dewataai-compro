---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import PageLayout from "@/layouts/page.astro"
import { getSite } from "@/lib/site"
import { resolveLang, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const site = getSite(lang)
---

<PageLayout title={`404 | ${site.brand.name}`} description={site.meta.description}>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden bg-background pt-32 pb-20">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute inset-0 grid-overlay opacity-60 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_40%,transparent_100%)]"
      >
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="eyebrow text-muted-foreground">404</p>
      <h1 class="t-heading mt-5 font-serif font-medium text-ink">
        <span class="t-line">Halaman ini</span>
        <span class="t-line">nggak ada.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-md leading-relaxed text-muted-foreground">
        Mungkin alamatnya salah ketik, atau halamannya sudah pindah. Balik ke beranda saja.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="btn-glossy inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
        >
          Beranda
          <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
        </a>
        <a
          href={path("ventures", "id")}
          class="inline-flex h-12 items-center gap-2 rounded-full border border-hairline px-6 text-sm font-medium text-ink transition-colors hover:border-ink/30"
        >
          Usaha kami
        </a>
      </div>
    </div>
  </section>
</PageLayout>
