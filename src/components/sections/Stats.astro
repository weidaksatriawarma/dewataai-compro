---
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
const s = getSite(resolveLang(Astro.currentLocale)).stats
---

<section class="relative overflow-hidden bg-background py-24 sm:py-32">
  <!-- backdrop texture -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 dot-overlay opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_50%,#000_40%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- header -->
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-muted-foreground">{s.eyebrow}</p>
      <h2
        class="t-heading mt-4 font-serif font-medium text-ink"
      >
        {lines(s.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
    </div>

    <!-- A ruled band rather than four tiles: the numbers are the loud part,
         so nothing needs to be drawn around them. -->
    <div class="mt-14 border-t border-ink">
      {
        s.items.map((item, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${120 + i * 70}ms`}
            class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 border-b border-hairline py-6 pr-1 sm:grid-cols-[10rem_1fr_auto] sm:gap-x-10 sm:pr-6"
          >
            <p class="flex items-baseline gap-0.5 whitespace-nowrap font-serif font-medium tracking-[-0.02em] text-ink">
              <span class="text-4xl sm:text-5xl">{item.value}</span>
              {item.unit && <span class="text-xl text-muted-foreground sm:text-2xl">{item.unit}</span>}
            </p>

            <p class="font-serif text-lg text-ink sm:text-xl">{item.label}</p>

            <p class="col-span-2 max-w-sm text-sm leading-relaxed text-muted-foreground sm:col-span-1 sm:text-right">
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
