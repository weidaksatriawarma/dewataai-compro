---
/**
 * Dewata Tech wordmark, matching how dewatatech.com sets it: Montserrat 900,
 * uppercase, slightly tracked out. Colour and size come from the caller.
 *
 *   <DewataTechWordmark class="text-2xl text-ink" />
 */
interface Props {
  class?: string
}
const { class: className = "" } = Astro.props
---

<span class:list={["dt-wordmark", className]}>Dewata Tech</span>

<style>
  .dt-wordmark {
    font-family: var(--font-wordmark);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    white-space: nowrap;
  }
</style>
