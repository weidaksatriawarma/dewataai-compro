# Security headers, served by Cloudflare's static asset handler.
#
# The Cloudflare adapter appends its own immutable Cache-Control rule for
# /_astro/* to this file at build time, so keep this file free of Cache-Control
# on that path or the injection is skipped.
#
# Everything below was chosen to be correct for this site specifically. A
# header that breaks the Sanity Studio at /admin is worse than no header,
# because the CMS is how the site gets updated.

/*
  # Stops a browser from second-guessing a declared Content-Type. Without it a
  # file served as text/plain can be sniffed and executed as script.
  X-Content-Type-Options: nosniff

  # Send the full URL to our own origin, only the origin to other sites, and
  # nothing at all when downgrading to HTTP. Keeps article paths out of the
  # referer header of outbound links.
  Referrer-Policy: strict-origin-when-cross-origin

  # One year of forced HTTPS. Deliberately without `includeSubDomains` and
  # without `preload`: both apply to every current and future subdomain, and
  # both are effectively irreversible for the lifetime of the max-age. Add them
  # once every subdomain is confirmed HTTPS-only.
  Strict-Transport-Security: max-age=31536000

  # The site asks for none of these, so deny them outright. An injected script
  # then cannot reach for the camera or the location API either.
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # Clickjacking. SAMEORIGIN rather than DENY so the Studio can still frame a
  # page if a preview tool is added later.
  X-Frame-Options: SAMEORIGIN

  # The enforcing policy is deliberately narrow: three directives that this
  # site cannot violate, so they can ship today without a staging period.
  # `base-uri` blocks an injected <base> tag from re-pointing every relative
  # URL, `object-src` kills plugin embedding, and `frame-ancestors` is the
  # modern half of the X-Frame-Options line above.
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'

  # The policy we actually want, running in report-only so it breaks nothing
  # while the violations are collected. Browsers log each violation to the
  # console. Once /admin and the marketing pages are both clean, this becomes
  # the enforcing header above.
  #
  # `style-src` keeps 'unsafe-inline' because the Studio ships styled-components,
  # which injects <style> at runtime and cannot be hashed. `script-src` has no
  # 'unsafe-inline' on purpose: the reports will name the inline scripts that
  # still need hashing.
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.sanity.io https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.sanity.io wss://*.sanity.io https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; worker-src 'self' blob:; manifest-src 'self'

# The key file and the webhook are machine endpoints. Nothing should frame,
# embed or cache them anywhere but the edge.
/indexnow-key.txt
  X-Robots-Tag: noindex

/api/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
