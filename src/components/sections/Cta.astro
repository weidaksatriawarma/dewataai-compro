---
import { HugeiconsIcon } from "@hugeicons/react"
import { WhatsappIcon, Mail01Icon } from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
const c = getSite(resolveLang(Astro.currentLocale)).cta
const STAR =
  "M16 3 L18 12.6 L24.5 6.6 L20.5 14.1 L30 16 L20.5 17.9 L24.5 25.4 L18 19.4 L16 29 L14 19.4 L7.5 25.4 L11.5 17.9 L2 16 L11.5 14.1 L7.5 6.6 L14 12.6 Z"
---

<section id="kontak" class="ink-section relative isolate overflow-hidden py-28 sm:py-36">
  <!-- backdrop layers -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-[0.18] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_50%,#000_45%,transparent_100%)]"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 h-[620px] w-[820px] max-w-[120vw] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(closest-side,rgba(255,255,255,0.10),transparent)]"
    >
    </div>
  </div>

  <!-- floating decorative keycaps / stars -->
  <div
    class="pointer-events-none absolute top-20 left-[8%] hidden animate-float lg:block"
    style="animation-delay:-3s"
    aria-hidden="true"
  >
    <span class="grid size-14 place-items-center rounded-2xl border border-white/12 bg-white/[0.06]">
      <svg viewBox="0 0 32 32" class="size-5 text-white/70" fill="currentColor">
        <path d={STAR}></path>
      </svg>
    </span>
  </div>
  <div
    class="pointer-events-none absolute right-[9%] bottom-24 hidden animate-float lg:block"
    style="animation-delay:-6s"
    aria-hidden="true"
  >
    <span class="grid size-12 place-items-center rounded-2xl border border-white/12 bg-white/[0.06] font-mono text-xs font-semibold text-white/60">
      AI
    </span>
  </div>

  <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
    <p data-reveal class="eyebrow text-white/60">{c.eyebrow}</p>

    <h2
      data-reveal
      style="--reveal-delay:80ms"
      class="t-display mt-6 font-serif font-medium text-white"
    >
      {lines(c.headline).map((line) => <span class="t-line">{line}</span>)}
    </h2>

    <p
      data-reveal
      style="--reveal-delay:160ms"
      class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-balance text-white/65 sm:text-lg"
    >
      {c.sub}
    </p>

    <div
      data-reveal
      style="--reveal-delay:240ms"
      class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href={c.primary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glossy inline-flex h-12 w-full items-center justify-center gap-2 rounded-full px-7 text-sm font-medium sm:w-auto"
      >
        <HugeiconsIcon icon={WhatsappIcon} size={18} strokeWidth={1.8} />
        {c.primary.label}
      </a>
      <a
        href={c.secondary.href}
        class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-white/20 px-7 text-sm font-medium text-white transition-colors hover:bg-white hover:text-ink sm:w-auto"
      >
        <HugeiconsIcon icon={Mail01Icon} size={17} strokeWidth={1.8} />
        {c.secondary.label}
      </a>
    </div>
  </div>
</section>
