---
import { getSite } from "@/lib/site"
import { resolveLang, getUI } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const ui = getUI(lang)
const items = getSite(lang).marquee
const STAR =
  "M16 3 L18 12.6 L24.5 6.6 L20.5 14.1 L30 16 L20.5 17.9 L24.5 25.4 L18 19.4 L16 29 L14 19.4 L7.5 25.4 L11.5 17.9 L2 16 L11.5 14.1 L7.5 6.6 L14 12.6 Z"
---

<section
  class="relative overflow-hidden border-y border-hairline bg-background py-5 sm:py-6"
  aria-label={ui.marqueeAria}
>
  <div data-reveal class="marquee-mask group overflow-hidden">
    <div
      class="flex w-max shrink-0 animate-marquee items-center gap-x-10 group-hover:[animation-play-state:paused] sm:gap-x-14"
    >
      {
        items.map((label) => (
          <span class="flex shrink-0 items-center gap-x-10 sm:gap-x-14">
            <span class="eyebrow whitespace-nowrap text-muted-foreground">{label}</span>
            <svg
              viewBox="0 0 32 32"
              class="size-2.5 shrink-0 text-ink/30"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={STAR} />
            </svg>
          </span>
        ))
      }
      {
        items.map((label) => (
          <span class="flex shrink-0 items-center gap-x-10 sm:gap-x-14" aria-hidden="true">
            <span class="eyebrow whitespace-nowrap text-muted-foreground">{label}</span>
            <svg
              viewBox="0 0 32 32"
              class="size-2.5 shrink-0 text-ink/30"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={STAR} />
            </svg>
          </span>
        ))
      }
    </div>
  </div>
</section>
