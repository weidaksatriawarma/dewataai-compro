---
import DewataTechWordmark from "@/components/DewataTechWordmark.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight01Icon,
  ArrowLeft01Icon,
  Tick02Icon,
  Cursor02Icon,
  Calendar03Icon,
  ArrowDataTransferHorizontalIcon,
  Search01Icon,
  BubbleChatIcon,
  Analytics01Icon,
  Package01Icon,
  Invoice01Icon,
} from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"
import { getSite, lines } from "@/lib/site"
import { getPages, type VentureSlug } from "@/lib/pages"
import { resolveLang, getUI, path } from "@/lib/i18n"

interface Props {
  slug: VentureSlug
}

const { slug } = Astro.props
const lang = resolveLang(Astro.currentLocale)
const ui = getUI(lang)
const site = getSite(lang)
const venture = site.ventures.items.find((item) => item.slug === slug)!
const d = getPages(lang).ventureDetail[slug]
const indexPath = path("ventures", lang)

/* Keyed off `icon` in pages.ts so both locales render the same glyph for the
   same capability. */
/* Only the venture with a documented defensibility story carries this block,
   so the section stays optional instead of a field every venture has to fake. */
const moat = "moat" in d ? d.moat : null

const SOLUTION_ICONS = {
  site: Cursor02Icon,
  booking: Calendar03Icon,
  sync: ArrowDataTransferHorizontalIcon,
  seo: Search01Icon,
  chat: BubbleChatIcon,
  profit: Analytics01Icon,
  stock: Package01Icon,
  report: Invoice01Icon,
} as const
---

<PageHero eyebrow={d.eyebrow} heading={d.headline} lead={d.lead} />

<!-- identity + proof -->
<section class="border-y border-hairline bg-paper py-10">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-6 px-5 sm:px-8">
    <div data-reveal class="flex items-center gap-3">
      {
        slug === "dagangku-ai" ? (
          <DagangkuWordmark class="text-2xl text-ink" />
        ) : (
          <DewataTechWordmark class="text-xl text-ink" />
        )
      }
      <span class="rounded-full border border-hairline px-3 py-1 text-xs text-muted-foreground">
        {venture.tag}
      </span>
    </div>

    <div data-reveal style="--reveal-delay:100ms" class="flex divide-x divide-hairline">
      {
        venture.proof.map((proof) => (
          <div class="px-5 first:pl-0 last:pr-0">
            <div class="font-serif text-xl text-ink">{proof.value}</div>
            <div class="mt-0.5 text-xs text-muted-foreground">{proof.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- problem -->
<section class="ink-section relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 dot-overlay opacity-[0.16] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_45%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-5xl gap-10 px-5 sm:px-8 lg:grid-cols-[1fr_0.7fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow text-white/55">{d.problem.label}</p>
      <h2 class="t-heading-sm mt-4 font-serif text-white">{d.problem.heading}</h2>
      <div class="mt-6 space-y-4">
        {d.problem.body.map((para) => <p class="max-w-xl leading-relaxed text-white/65">{para}</p>)}
      </div>
    </div>

    <div
      data-reveal
      style="--reveal-delay:120ms"
      class="self-start rounded-3xl border border-white/12 bg-white/[0.04] p-7"
    >
      <div class="font-serif text-4xl leading-none text-white">{d.problem.cost.value}</div>
      <p class="mt-3 text-sm leading-relaxed text-white/60">{d.problem.cost.label}</p>
    </div>
  </div>
</section>

<!-- solution -->
<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{d.solution.label}</p>
      <h2 class="t-heading-sm mt-4 font-serif text-ink">{d.solution.heading}</h2>
    </div>

    <div class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        d.solution.items.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="border-t border-hairline pt-5">
            <span class="grid size-10 place-items-center rounded-xl border border-hairline bg-muted text-ink">
              <HugeiconsIcon icon={SOLUTION_ICONS[item.icon]} size={19} strokeWidth={1.7} />
            </span>
            <h3 class="mt-4 font-serif text-xl text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{item.desc}</p>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-14 border-t border-hairline pt-8">
      <p class="eyebrow text-muted-foreground">{d.forWho.label}</p>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {
          d.forWho.items.map((item) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-hairline px-4 py-2 text-sm text-ink">
              <HugeiconsIcon icon={Tick02Icon} size={13} strokeWidth={2.2} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- moat: the answer to "this is just a chat wrapper" -->
{
  moat && (
    <section class="ink-section relative overflow-hidden py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div
          class="absolute inset-0 grid-overlay opacity-30 [mask-image:radial-gradient(ellipse_65%_60%_at_50%_0%,#000_40%,transparent_100%)]"
        />
      </div>

      <div class="mx-auto max-w-5xl px-5 sm:px-8">
        <div data-reveal class="max-w-2xl">
          <p class="eyebrow text-white/55">{moat.label}</p>
          <h2 class="t-heading-sm mt-4 font-serif text-white">
            {lines(moat.heading).map((line) => (
              <span class="t-line">{line}</span>
            ))}
          </h2>
          <div class="mt-6 space-y-4">
            {moat.body.map((para) => (
              <p class="leading-relaxed text-white/65">{para}</p>
            ))}
          </div>
        </div>

        {/* Each claim carries its own status, so a design never reads as shipped. */}
        <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {moat.items.map((item, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="border-t border-white/12 pt-5"
            >
              <span class="inline-flex items-center gap-2 rounded-full border border-white/12 px-3 py-1 font-mono text-[11px] text-white/55">
                <span
                  class:list={[
                    "size-1.5 rounded-full",
                    item.live ? "bg-white" : "bg-white/30",
                  ]}
                />
                {item.status}
              </span>
              <h3 class="mt-4 font-serif text-xl text-white">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-white/60">{item.desc}</p>
            </div>
          ))}
        </div>

        <div
          data-reveal
          style="--reveal-delay:120ms"
          class="mt-12 rounded-3xl border border-white/12 bg-white/[0.04] p-7"
        >
          <p class="eyebrow text-white/55">{moat.limit.label}</p>
          <p class="mt-3 max-w-3xl leading-relaxed text-white/65">{moat.limit.body}</p>
        </div>
      </div>
    </section>
  )
}

<!-- cta -->
<section class="bg-paper py-16 sm:py-20">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-6 px-5 sm:px-8"
  >
    <div data-reveal class="max-w-xl">
      <h2 class="font-serif text-2xl text-ink">{d.cta.heading}</h2>
      <p class="mt-2 leading-relaxed text-muted-foreground">{d.cta.body}</p>
    </div>
    <a
      data-reveal
      style="--reveal-delay:100ms"
      href={venture.url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-glossy inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
    >
      {d.cta.label}
      <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
    </a>
  </div>

  <div class="mx-auto mt-12 max-w-5xl px-5 sm:px-8">
    <a
      href={indexPath}
      class="link-underline inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-ink"
    >
      <HugeiconsIcon icon={ArrowLeft01Icon} size={15} strokeWidth={2} />
      {ui.backTo} {getPages(lang).ventures.eyebrow.toLowerCase()}
    </a>
  </div>
</section>
