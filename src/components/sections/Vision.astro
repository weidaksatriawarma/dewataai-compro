---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Compass01Icon,
  Tick02Icon,
  Shield01Icon,
  ArrowUpRight01Icon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
const v = getSite(resolveLang(Astro.currentLocale)).vision
const o = v.offer
const STAR =
  "M16 3 L18 12.6 L24.5 6.6 L20.5 14.1 L30 16 L20.5 17.9 L24.5 25.4 L18 19.4 L16 29 L14 19.4 L7.5 25.4 L11.5 17.9 L2 16 L11.5 14.1 L7.5 6.6 L14 12.6 Z"
---

<section id="visi" class="ink-section relative overflow-hidden py-24 sm:py-32">
  <!-- backdrop layers -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-40 [mask-image:radial-gradient(ellipse_70%_60%_at_30%_0%,#000_45%,transparent_100%)]"
    >
    </div>
    <svg
      viewBox="0 0 32 32"
      class="absolute -right-16 -bottom-16 h-[440px] w-[440px] max-w-[60vw] text-white/[0.05] sm:-right-24"
      fill="currentColor"
    >
      <path d={STAR}></path>
    </svg>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- eyebrow -->
    <p data-reveal class="flex items-center gap-2.5">
      <span class="grid size-7 place-items-center rounded-full border border-white/10 bg-white/5">
        <HugeiconsIcon icon={Compass01Icon} size={15} strokeWidth={1.6} />
      </span>
      <span class="eyebrow text-white/60">{v.eyebrow}</span>
    </p>

    <!-- VISION + OFFER -->
    <div class="mt-10 grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <p data-reveal style="--reveal-delay:80ms" class="eyebrow text-white/60">{v.visionLabel}</p>
        <h2
          data-reveal
          style="--reveal-delay:160ms"
          class="t-heading mt-5 font-serif font-medium text-white"
        >
          {lines(v.visionText).map((line) => <span class="t-line">{line}</span>)}
        </h2>

        <!-- MISSION: sits under the vision so the offer card has a partner column -->
        <div data-reveal style="--reveal-delay:240ms" class="mt-12 border-t border-white/10 pt-10">
          <p class="eyebrow text-white/60">{v.missionLabel}</p>

          <div class="mt-7 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-1">
            {
              v.missionPoints.map((point, i) => (
                <div
                  data-reveal
                  style={`--reveal-delay:${320 + i * 80}ms`}
                  class="flex gap-5 border-t border-white/10 pt-4"
                >
                  <span class="font-mono text-sm font-medium text-white/55 tabular-nums">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="text-base leading-relaxed text-white/80">{point}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- offer card: what a 15-minute call actually gets you -->
      <aside
        id="penawaran"
        data-reveal
        style="--reveal-delay:240ms"
        class="scroll-mt-28 rounded-3xl border border-white/12 bg-white/[0.04] p-6 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)] sm:p-8"
      >
        <p class="eyebrow text-white/55">{o.eyebrow}</p>

        <p class="t-heading-sm mt-4 font-serif text-white">
          {lines(o.heading).map((line) => <span class="t-line">{line}</span>)}
        </p>

        <p class="mt-4 text-sm leading-relaxed text-white/65">{o.sub}</p>

        <ul class="mt-6 space-y-3 border-t border-white/10 pt-6">
          {
            o.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-white/20 text-white">
                  <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2} />
                </span>
                <span class="text-sm text-white/85">{item}</span>
              </li>
            ))
          }
        </ul>

        <p
          class="mt-6 flex items-start gap-2.5 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white/70"
        >
          <span class="mt-0.5 shrink-0 text-white">
            <HugeiconsIcon icon={Shield01Icon} size={15} strokeWidth={1.8} />
          </span>
          {o.guarantee}
        </p>

        <a
          href={o.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glossy mt-6 inline-flex h-11 w-full items-center justify-center gap-2 rounded-full px-5 text-sm font-medium"
        >
          {o.cta.label}
          <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
        </a>

        <p class="mt-3 text-center text-xs text-white/45">{o.note}</p>
      </aside>
    </div>

  </div>
</section>
