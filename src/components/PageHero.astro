---
/** Standard header for every page below the homepage. */
import { lines } from "@/lib/site"

interface Props {
  eyebrow: string
  heading: string
  lead?: string
  meta?: string
}

const { eyebrow, heading, lead, meta } = Astro.props
---

<section class="relative overflow-hidden bg-background pt-32 pb-14 sm:pt-40 sm:pb-20">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_45%,transparent_100%)]"
    >
    </div>
    <div
      class="glow absolute top-[-18%] left-1/2 h-[420px] w-[760px] max-w-[120vw] -translate-x-1/2 bg-[radial-gradient(closest-side,var(--glow-fg),transparent)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <p data-reveal class="eyebrow text-muted-foreground">{eyebrow}</p>

    <h1
      data-reveal
      style="--reveal-delay:80ms"
      class="t-heading mt-5 font-serif font-medium text-ink"
    >
      {lines(heading).map((line) => <span class="t-line">{line}</span>)}
    </h1>

    {
      lead && (
        <p
          data-reveal
          style="--reveal-delay:160ms"
          class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          {lead}
        </p>
      )
    }

    {
      meta && (
        <p data-reveal style="--reveal-delay:220ms" class="mt-6 font-mono text-xs text-muted-foreground">
          {meta}
        </p>
      )
    }
  </div>
</section>
