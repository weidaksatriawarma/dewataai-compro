---
import DewataTechWordmark from "@/components/DewataTechWordmark.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon, Shield01Icon, Tick02Icon } from "@hugeicons/core-free-icons"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"
import { getSite, lines } from "@/lib/site"
import { getPages } from "@/lib/pages"
import { resolveLang, detailPath, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const site = getSite(lang)
const v = site.ventures
const p = getPages(lang).ventures
const reg = p.register
const third = p.third
const legal = site.brand.legal
---

{/*
  Hero as a register of holdings rather than a headline + card grid: the
  artifact a holding company actually keeps. Entries are the navigation, and
  entry 03 is vacant on purpose.
*/}
<section class="relative overflow-hidden bg-background pt-28 pb-4 sm:pt-32">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-50 [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_40%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- issuing strip: who the register belongs to -->
    <div
      data-reveal
      class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b border-ink pb-3"
    >
      <p class="eyebrow text-ink">{reg.label}</p>
      <p class="font-mono text-[0.7rem] tracking-tight text-muted-foreground">
        <span class="hidden sm:inline">{reg.issuedBy}: </span>{legal.legalName}
        <span class="text-ink/25"> · </span>NIB {legal.nib}
      </p>
    </div>

    <!-- statement -->
    <div class="grid gap-6 pt-10 pb-12 sm:pt-14 sm:pb-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <h1
        data-reveal
        style="--reveal-delay:70ms"
        class="t-heading font-serif font-medium text-ink"
      >
        {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
      </h1>
      <p
        data-reveal
        style="--reveal-delay:140ms"
        class="max-w-md self-end leading-relaxed text-muted-foreground"
      >
        {p.lead}
      </p>
    </div>

    <!-- the register -->
    <div class="register">
      <!-- column headers, desktop only -->
      <div
        data-reveal
        style="--reveal-delay:180ms"
        class="hidden grid-cols-[3.5rem_1fr_8rem_7rem_2rem] gap-6 border-b border-hairline pb-2.5 sm:grid sm:pr-6"
      >
        <span class="reg-head">{reg.columns.no}</span>
        <span class="reg-head">{reg.columns.name}</span>
        <span class="reg-head">{reg.columns.field}</span>
        <span class="reg-head">{reg.columns.status}</span>
        <span class="sr-only">{reg.columns.domain}</span>
      </div>

      {
        v.items.map((venture, i) => (
          <a
            data-reveal
            style={`--reveal-delay:${220 + i * 90}ms`}
            href={detailPath("ventures", lang, venture.slug)}
            class="reg-row group grid grid-cols-[2.75rem_1fr_auto] items-baseline gap-x-4 gap-y-2 border-b border-hairline py-5 pr-1 sm:grid-cols-[3.5rem_1fr_8rem_7rem_2rem] sm:items-center sm:gap-6 sm:pr-6"
          >
            <span class="font-mono text-sm text-muted-foreground tabular-nums">{venture.index}</span>

            <span class="reg-name min-w-0">
              {venture.slug === "dagangku-ai" ? (
                <DagangkuWordmark class="text-xl text-ink sm:text-2xl" />
              ) : (
                <DewataTechWordmark class="text-lg text-ink sm:text-xl" />
              )}
              <span class="mt-1 block font-mono text-xs text-muted-foreground sm:hidden">
                {venture.tag} · {venture.domain}
              </span>
            </span>

            <span class="hidden font-mono text-xs text-muted-foreground sm:block">{venture.tag}</span>

            <span class="col-start-3 row-start-1 flex items-center gap-2 justify-self-end font-mono text-xs text-muted-foreground sm:col-start-auto sm:row-start-auto sm:justify-self-start">
              <span class="size-1.5 rounded-full bg-ink" />
              {reg.statusActive}
            </span>

            <span class="reg-arrow hidden justify-self-end text-ink sm:block">
              <HugeiconsIcon icon={ArrowUpRight01Icon} size={17} strokeWidth={1.8} />
            </span>
          </a>
        ))
      }

      <!-- signature: the vacant entry -->
      <a
        data-reveal
        style={`--reveal-delay:${220 + v.items.length * 90}ms`}
        href="#usaha-ketiga"
        class="reg-row reg-vacant group grid grid-cols-[2.75rem_1fr_auto] items-baseline gap-x-4 gap-y-2 border-b border-hairline py-5 pr-1 sm:grid-cols-[3.5rem_1fr_8rem_7rem_2rem] sm:items-center sm:gap-6 sm:pr-6"
      >
        <span class="font-mono text-sm text-ink/30 tabular-nums">{reg.vacant.no}</span>

        <span class="min-w-0">
          <span class="reg-blank font-serif text-xl text-ink/35 sm:text-2xl">{reg.vacant.name}</span>
          <span class="mt-1.5 block max-w-md text-xs leading-relaxed text-muted-foreground">
            {reg.vacant.desc}
          </span>
        </span>

        <span class="hidden font-mono text-xs text-ink/30 sm:block">{reg.vacant.field}</span>

        <span class="col-start-3 row-start-1 flex items-center gap-2 justify-self-end font-mono text-xs text-ink/40 sm:col-start-auto sm:row-start-auto sm:justify-self-start">
          <span class="size-1.5 rounded-full border border-ink/35" />
          {reg.statusOpen}
        </span>

        <span class="reg-arrow hidden justify-self-end text-ink/40 sm:block">
          <HugeiconsIcon icon={Shield01Icon} size={17} strokeWidth={1.8} />
        </span>
      </a>
    </div>
  </div>
</section>

<!-- expanded entries -->
<section class="relative bg-paper py-16 sm:py-24">
  <div class="mx-auto max-w-6xl space-y-6 px-5 sm:px-8">
    {
      v.items.map((venture, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i * 100}ms`}
          id={venture.slug}
          class="scroll-mt-24 rounded-3xl border border-hairline bg-background p-6 sm:p-9"
        >
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-sm text-muted-foreground">{venture.index}</span>
            {venture.slug === "dagangku-ai" ? (
              <DagangkuWordmark class="text-2xl text-ink" />
            ) : (
              <DewataTechWordmark class="text-xl text-ink" />
            )}
            <span class="rounded-full border border-hairline px-3 py-1 text-xs text-muted-foreground">
              {venture.tag}
            </span>
          </div>

          <p class="mt-5 max-w-2xl text-lg leading-snug text-ink">
            {venture.headline.replace("\n", " ")}
          </p>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{venture.desc}</p>

          <ul class="mt-6 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
            {venture.features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-hairline text-ink">
                  <HugeiconsIcon icon={Tick02Icon} size={11} strokeWidth={2.2} />
                </span>
                <span class="text-sm text-muted-foreground">{feat}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7 grid max-w-md grid-cols-3 divide-x divide-hairline">
            {venture.proof.map((proof) => (
              <div class="px-4 first:pl-0">
                <div class="font-serif text-xl text-ink">{proof.value}</div>
                <div class="mt-0.5 text-xs text-muted-foreground">{proof.label}</div>
              </div>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={detailPath("ventures", lang, venture.slug)}
              class="btn-glossy inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
            >
              {p.openLabel}
              <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
            </a>
            <a
              href={venture.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-full border border-hairline px-5 text-sm font-medium text-ink transition-colors hover:border-ink/30"
            >
              {venture.domain}
              <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
            </a>
          </div>
        </article>
      ))
    }

    {/* Entry 03 is a direction, not a product. The limits are listed as the
        substance of the entry rather than as a footnote to it. */}
    <article
      data-reveal
      id="usaha-ketiga"
      class="scroll-mt-24 rounded-3xl border border-hairline bg-background p-6 sm:p-9"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-mono text-sm text-muted-foreground">{third.index}</span>
        <span class="font-serif text-xl text-ink sm:text-2xl">{third.name}</span>
        <span class="rounded-full border border-hairline px-3 py-1 text-xs text-muted-foreground">
          {third.tag}
        </span>
        <span class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
          <span class="size-1.5 rounded-full border border-ink/35" />
          {reg.statusOpen}
        </span>
      </div>

      <p class="mt-5 max-w-2xl text-lg leading-snug text-ink">
        {lines(third.headline).map((line) => <span class="t-line">{line}</span>)}
      </p>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{third.desc}</p>

      <p class="eyebrow mt-7 text-muted-foreground">{third.boundsLabel}</p>
      <ul class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          third.bounds.map((bound) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-hairline text-ink">
                <HugeiconsIcon icon={Tick02Icon} size={11} strokeWidth={2.2} />
              </span>
              <span class="text-sm text-muted-foreground">{bound}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <a
          href={path("safety", lang)}
          class="btn-glossy inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
        >
          {third.cta}
          <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .reg-head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  /* A register entry reads as a ruled line: hovering pulls it right the way a
     finger tracks down a ledger. */
  .reg-row {
    transition:
      background-color 0.3s ease,
      padding-left 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .reg-row:hover,
  .reg-row:focus-visible {
    background-color: color-mix(in oklch, var(--foreground) 4%, transparent);
    padding-left: 0.75rem;
  }
  .reg-arrow {
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .reg-row:hover .reg-arrow {
    transform: translate(3px, -3px);
  }

  /* The vacant entry: a name waiting to be written in. */
  .reg-blank {
    padding-bottom: 0.15em;
    background-image: linear-gradient(
      to right,
      color-mix(in oklch, var(--foreground) 35%, transparent) 0 2px,
      transparent 2px 6px
    );
    background-repeat: repeat-x;
    background-position: 0 100%;
    background-size: 6px 1px;
    transition: background-size 0.3s ease;
  }
  .reg-vacant:hover .reg-blank {
    background-image: linear-gradient(
      to right,
      color-mix(in oklch, var(--foreground) 55%, transparent) 0 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .reg-row,
    .reg-arrow,
    .reg-blank {
      transition: none;
    }
  }
</style>
