---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  BrainIcon,
  SourceCodeIcon,
  RoboticIcon,
  Atom01Icon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"

const p = getSite(resolveLang(Astro.currentLocale)).pillars

const ICONS = {
  brain: BrainIcon,
  code: SourceCodeIcon,
  automation: RoboticIcon,
  research: Atom01Icon,
} as const
---

<section id="kapabilitas" class="relative overflow-hidden bg-background py-24 sm:py-32">
  <!-- backdrop texture -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 dot-overlay opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_50%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- header -->
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{p.eyebrow}</p>
      <h2
        class="t-heading mt-4 font-serif font-medium text-ink"
      >
        {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg text-balance">
        {p.sub}
      </p>
    </div>

    <!-- cards -->
    <div class="mt-12 grid gap-5 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
      {
        p.items.map((item, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${(i + 1) * 80}ms`}
            class="lift relative rounded-2xl border border-hairline bg-background p-6"
          >
            <span
              class="absolute top-6 right-6 font-mono text-xs text-muted-foreground"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>

            <span class="grid size-12 place-items-center rounded-xl border border-hairline text-ink">
              <HugeiconsIcon
                icon={ICONS[item.key as keyof typeof ICONS]}
                size={22}
                strokeWidth={1.5}
              />
            </span>

            <h3 class="mt-5 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
