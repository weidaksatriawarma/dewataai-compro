---
import PageLayout from "@/layouts/page.astro"
import PrivacyPage from "@/components/pages/PrivacyPage.astro"
import { getPages } from "@/lib/pages"
import { resolveLang, path } from "@/lib/i18n"

const p = getPages(resolveLang(Astro.currentLocale)).privacy
---

<PageLayout
  title={p.meta.title}
  description={p.meta.description}
  pathId={path("privacy", "id")}
  pathEn={path("privacy", "en")}
>
  <PrivacyPage />
</PageLayout>
