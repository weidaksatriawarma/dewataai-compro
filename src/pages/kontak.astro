---
import PageLayout from "@/layouts/page.astro"
import ContactPage from "@/components/pages/ContactPage.astro"
import { getPages } from "@/lib/pages"
import { resolveLang, path } from "@/lib/i18n"

const p = getPages(resolveLang(Astro.currentLocale)).contact
---

<PageLayout
  title={p.meta.title}
  description={p.meta.description}
  pathId={path("contact", "id")}
  pathEn={path("contact", "en")}
>
  <ContactPage />
</PageLayout>
