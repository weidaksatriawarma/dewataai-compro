# Sanity CMS — powers /jurnal (blog) and /pers (press releases).
#
# Two files are used, both gitignored:
#   .env              local development (astro dev). Loaded in every mode.
#   .env.production   production build (astro build / npm run deploy).
#                     Overrides .env, so it can point at a different dataset.
#
# Both are OPTIONAL. The live project id and dataset are committed as defaults
# in astro.config.mjs and sanity.config.ts, because Astro inlines them into the
# browser bundle at build time and they are therefore public either way. That
# keeps a build from git working on any host without extra configuration.
#
# Set these only to point the site at a different Sanity project or dataset,
# for example a staging one. Values here win over the committed defaults.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Add http://localhost:4321 and https://dewataai.com as CORS origins in
# sanity.io/manage (with credentials allowed) so the embedded Studio at /admin
# can authenticate. Opening /admin on an unregistered origin also offers a
# one-click "Add CORS origin" prompt.

# ---------------------------------------------------------------------------
# Measurement. All optional: each tag is omitted entirely when its var is unset,
# so a build without them ships no third-party script.
# Set these in .env.production, then redeploy.
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement id. analytics.google.com -> Admin -> Data
# streams -> Web -> the "G-" id in the top right. Only loads in a production
# build, so `astro dev` never reports as real traffic.
PUBLIC_GA_ID=

# Google Search Console, HTML tag method. search.google.com/search-console ->
# add a URL-prefix property for https://dewataai.com -> HTML tag -> copy only
# the content value, not the whole tag.
#
# A DNS TXT record on the domain is the better option where it is available: it
# verifies every subdomain and every protocol at once and survives redeploys
# with no code change. Use this var only if DNS is not an option.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools. bing.com/webmasters -> Add site. The fastest path is
# "Import from Google Search Console", which skips verification entirely. Use
# this var for the manual meta-tag method (the msvalidate.01 content value).
PUBLIC_BING_SITE_VERIFICATION=
