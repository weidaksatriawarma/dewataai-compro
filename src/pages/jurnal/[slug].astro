---
// Rendered on demand: a post published in Sanity is live on the next request,
// no rebuild required.
export const prerender = false

import PageLayout from "@/layouts/page.astro"
import ArticleDetail from "@/components/pages/ArticleDetail.astro"
import { getArticle } from "@/lib/cms"
import { detailPath } from "@/lib/i18n"

const slug = Astro.params.slug!
const article = await getArticle("post", "id", slug)
if (!article) return Astro.rewrite("/404")
---

<PageLayout
  title={`${article.title} | Jurnal Dewata AI`}
  description={article.excerpt}
  pathId={detailPath("journal", "id", slug)}
  pathEn={detailPath("journal", "en", slug)}
>
  <ArticleDetail kind="post" article={article} />
</PageLayout>
