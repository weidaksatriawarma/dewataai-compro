---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight01Icon,
  WhatsappIcon,
  Mail01Icon,
  Location01Icon,
  Tick02Icon,
  Shield01Icon,
} from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import { getSite, lines } from "@/lib/site"
import { getPages } from "@/lib/pages"
import { resolveLang } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const site = getSite(lang)
const p = getPages(lang).contact
const offer = site.vision.offer
const legal = site.brand.legal

const ICONS = { whatsapp: WhatsappIcon, email: Mail01Icon, office: Location01Icon } as const
const HREFS: Record<string, string> = {
  whatsapp: site.brand.whatsapp,
  email: `mailto:${site.brand.email}`,
  office: legal.ahuUrl,
}
const VALUES: Record<string, string> = {
  whatsapp: "WhatsApp",
  email: site.brand.email,
  office: legal.addressLine,
}
---

<PageHero eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />

<section class="bg-paper py-16 sm:py-24">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 sm:px-8 lg:grid-cols-[1fr_0.85fr] lg:gap-14">
    <!-- channels + next steps -->
    <div>
      <p data-reveal class="eyebrow text-muted-foreground">{p.channels.label}</p>

      <div class="mt-6 space-y-3">
        {
          p.channels.items.map((item, i) => {
            const isOffice = item.key === "office"
            return (
              <a
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
                href={HREFS[item.key]}
                {...(isOffice ? {} : { target: "_blank", rel: "noopener noreferrer" })}
                class="lift flex items-start gap-4 rounded-2xl border border-hairline bg-background p-5 transition-colors hover:border-ink/25"
              >
                <span class="grid size-10 shrink-0 place-items-center rounded-xl border border-hairline text-ink">
                  <HugeiconsIcon icon={ICONS[item.key as keyof typeof ICONS]} size={18} strokeWidth={1.7} />
                </span>
                <span class="min-w-0">
                  <span class="block font-medium text-ink">{item.title}</span>
                  <span class="mt-0.5 block text-sm text-muted-foreground">{item.desc}</span>
                  <span class="mt-2 block truncate text-sm font-medium text-ink">
                    {VALUES[item.key]}
                  </span>
                </span>
              </a>
            )
          })
        }
      </div>

      <div data-reveal class="mt-12 border-t border-hairline pt-8">
        <p class="eyebrow text-muted-foreground">{p.steps.label}</p>
        <ol class="mt-6 space-y-5">
          {
            p.steps.items.map((step) => (
              <li class="flex gap-4">
                <span class="font-mono text-sm text-muted-foreground tabular-nums">{step.index}</span>
                <span>
                  <span class="block font-medium text-ink">{step.title}</span>
                  <span class="mt-0.5 block text-sm text-muted-foreground">{step.desc}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- the offer -->
    <aside
      data-reveal
      style="--reveal-delay:140ms"
      class="ink-section self-start rounded-3xl border border-white/12 p-6 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)] sm:p-8"
    >
      <p class="eyebrow text-white/55">{offer.eyebrow}</p>

      <p class="t-heading-sm mt-4 font-serif text-white">
        {lines(offer.heading).map((line) => <span class="t-line">{line}</span>)}
      </p>

      <p class="mt-4 text-sm leading-relaxed text-white/65">{offer.sub}</p>

      <ul class="mt-6 space-y-3 border-t border-white/10 pt-6">
        {
          offer.items.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-white/20 text-white">
                <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2} />
              </span>
              <span class="text-sm text-white/85">{item}</span>
            </li>
          ))
        }
      </ul>

      <p
        class="mt-6 flex items-start gap-2.5 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white/70"
      >
        <span class="mt-0.5 shrink-0 text-white">
          <HugeiconsIcon icon={Shield01Icon} size={15} strokeWidth={1.8} />
        </span>
        {offer.guarantee}
      </p>

      <a
        href={offer.cta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glossy mt-6 inline-flex h-11 w-full items-center justify-center gap-2 rounded-full px-5 text-sm font-medium"
      >
        {offer.cta.label}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
      </a>

      <p class="mt-3 text-center text-xs text-white/45">{offer.note}</p>
    </aside>
  </div>
</section>
