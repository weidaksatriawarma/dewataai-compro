---
/**
 * The not-found body, shared by the /404 route and by any on-demand route
 * whose slug does not resolve.
 *
 * Those routes cannot rewrite to /404: it is prerendered, and Astro refuses to
 * rewrite an on-demand route with a static one under `server` output, which
 * turns every missing article into a 500. They render this instead and set the
 * status themselves.
 */
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import { resolveLang, path, localeHref } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)

const copy = {
  id: {
    headingTop: "Halaman ini",
    headingBottom: "nggak ada.",
    body: "Mungkin alamatnya salah ketik, atau halamannya sudah pindah. Balik ke beranda saja.",
    home: "Beranda",
    ventures: "Usaha kami",
  },
  en: {
    headingTop: "This page",
    headingBottom: "does not exist.",
    body: "The address may have a typo, or the page has moved. Head back to the homepage.",
    home: "Home",
    ventures: "Our ventures",
  },
}[lang]
---

<section
  class="relative flex min-h-[70vh] items-center overflow-hidden bg-background pt-32 pb-20"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="grid-overlay absolute inset-0 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_40%,transparent_100%)] opacity-60"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
    <p class="eyebrow text-muted-foreground">404</p>
    <h1 class="t-heading mt-5 font-serif font-medium text-ink">
      <span class="t-line">{copy.headingTop}</span>
      <span class="t-line">{copy.headingBottom}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-md leading-relaxed text-muted-foreground">
      {copy.body}
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={localeHref(lang)}
        class="btn-glossy inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
      >
        {copy.home}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
      </a>
      <a
        href={path("ventures", lang)}
        class="inline-flex h-12 items-center gap-2 rounded-full border border-hairline px-6 text-sm font-medium text-ink transition-colors hover:border-ink/30"
      >
        {copy.ventures}
      </a>
    </div>
  </div>
</section>
