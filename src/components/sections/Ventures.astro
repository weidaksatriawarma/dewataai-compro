---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Tick02Icon,
  ArrowUpRight01Icon,
  PlusSignIcon,
  SparklesIcon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
import { images } from "@/lib/images"
import PlaceholderImage from "@/components/PlaceholderImage.astro"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"

const v = getSite(resolveLang(Astro.currentLocale)).ventures
const [tech, dagang] = v.items
const upcoming = v.upcoming
---

<section id="ekosistem" class="ink-section relative overflow-hidden py-24 sm:py-32">
  <!-- backdrop layers -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-[0.35] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_50%,transparent_100%)]"
    >
    </div>
    <div
      class="glow absolute top-[-10%] left-1/2 h-[520px] w-[820px] max-w-[120vw] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(255,255,255,0.06),transparent)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- header -->
    <div class="mx-auto max-w-2xl text-center">
      <p data-reveal class="eyebrow text-white/65">{v.eyebrow}</p>
      <h2
        data-reveal
        style="--reveal-delay:90ms"
        class="t-heading mt-4 font-serif font-medium text-white"
      >
        {lines(v.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:170ms"
        class="mx-auto mt-5 max-w-xl text-balance text-white/60"
      >
        {v.sub}
      </p>
    </div>

    <!-- ventures -->
    <div class="mt-20 space-y-24 sm:space-y-28">
      <!-- ============ Venture 01 · Dewata Tech (text LEFT / visual RIGHT) ============ -->
      <article class="grid items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16">
        <!-- TEXT -->
        <div data-reveal class="md:order-1">
          <span class="block font-mono text-5xl font-light text-white/25 sm:text-6xl">{tech.index}</span>

          <div class="mt-6 flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-xl border border-white/15 bg-white/10 font-mono font-semibold text-white">
              {tech.mono}
            </span>
            <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-white/70">
              {tech.tag}
            </span>
          </div>

          <h3 class="t-heading-sm mt-6 font-serif text-white">
            {lines(tech.headline).map((line) => <span class="t-line">{line}</span>)}
          </h3>
          <p class="mt-4 max-w-lg leading-relaxed text-white/65">{tech.desc}</p>

          <ul class="mt-7 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {
              tech.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-white/20 text-white">
                    <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2} />
                  </span>
                  <span class="text-sm text-white/80">{feat}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 grid max-w-md grid-cols-3 divide-x divide-white/15">
            {
              tech.proof.map((p) => (
                <div class="px-4 first:pl-0">
                  <div class="font-serif text-xl text-white">{p.value}</div>
                  <div class="mt-0.5 text-xs text-white/60">{p.label}</div>
                </div>
              ))
            }
          </div>

          <a
            href={tech.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-glossy mt-9 inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
          >
            {tech.cta}
            <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
          </a>
        </div>

        <!-- VISUAL -->
        <div data-reveal style="--reveal-delay:140ms" class="md:order-2">
          <div class="lift rounded-3xl border border-white/10 bg-white/[0.05] p-2 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.8)]">
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <!-- browser chrome -->
              <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
                <div class="flex gap-1.5">
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                </div>
                <div
                  class="mx-auto flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/55"
                >
                  <span class="size-1.5 rounded-full bg-white/70"></span>
                  {tech.domain}
                </div>
                <span class="eyebrow hidden text-white/55 sm:block">{tech.demo.statusLabel}</span>
              </div>

              <!-- portfolio image -->
              <div class="relative">
                {/* TODO: ganti dengan gambar portofolio Anda */}
                <PlaceholderImage
                  src={images.portfolio}
                  seed="portfolio"
                  alt={tech.demo.imageAlt}
                  class="aspect-[16/10]"
                />
                <div
                  class="absolute bottom-3 left-3 flex items-center gap-2 rounded-full border border-white/15 bg-black/70 px-3 py-1.5 text-xs font-medium text-white"
                >
                  <span class="size-1.5 rounded-full bg-white"></span>
                  {tech.demo.caption}
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ============ Venture 02 · Dagangku AI (visual LEFT / text RIGHT) ============ -->
      <article class="grid items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16">
        <!-- TEXT -->
        <div data-reveal class="md:order-2">
          <span class="block font-mono text-5xl font-light text-white/25 sm:text-6xl">{dagang.index}</span>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <DagangkuWordmark class="text-2xl text-white sm:text-3xl" />
            <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-white/70">
              {dagang.tag}
            </span>
          </div>

          <h3 class="t-heading-sm mt-6 font-serif text-white">
            {lines(dagang.headline).map((line) => <span class="t-line">{line}</span>)}
          </h3>
          <p class="mt-4 max-w-lg leading-relaxed text-white/65">{dagang.desc}</p>

          <ul class="mt-7 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {
              dagang.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-white/20 text-white">
                    <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2} />
                  </span>
                  <span class="text-sm text-white/80">{feat}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 grid max-w-md grid-cols-3 divide-x divide-white/15">
            {
              dagang.proof.map((p) => (
                <div class="px-4 first:pl-0">
                  <div class="font-serif text-xl text-white">{p.value}</div>
                  <div class="mt-0.5 text-xs text-white/60">{p.label}</div>
                </div>
              ))
            }
          </div>

          <a
            href={dagang.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-glossy mt-9 inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
          >
            {dagang.cta}
            <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
          </a>
        </div>

        <!-- VISUAL · monochrome chat mockup -->
        <div data-reveal style="--reveal-delay:140ms" class="md:order-1">
          <div class="lift rounded-3xl border border-white/10 bg-white/[0.05] p-2 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.8)]">
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <!-- app chrome -->
              <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
                <DagangkuWordmark class="text-base text-white" />
                <span class="ml-auto flex items-center gap-1.5 text-xs text-white/60">
                  <HugeiconsIcon icon={SparklesIcon} size={13} strokeWidth={1.7} />
                  {dagang.demo.online}
                </span>
              </div>

              <!-- chat thread -->
              <div class="flex flex-col gap-3 p-4 sm:p-5">
                <!-- user -->
                <div class="flex justify-end">
                  <p class="max-w-[78%] rounded-2xl rounded-br-md bg-white px-3 py-2 text-sm text-ink">
                    {dagang.demo.msg1}
                  </p>
                </div>
                <!-- AI -->
                <div class="flex justify-start">
                  <p class="max-w-[78%] rounded-2xl rounded-bl-md bg-white/10 px-3 py-2 text-sm text-white/90">
                    {dagang.demo.recorded}
                    <span class="text-white"> &#10003;</span> Rp25.000 &middot; {dagang.demo.category}
                  </p>
                </div>
                <!-- user -->
                <div class="flex justify-end">
                  <p class="max-w-[78%] rounded-2xl rounded-br-md bg-white px-3 py-2 text-sm text-ink">
                    {dagang.demo.msg2}
                  </p>
                </div>
                <!-- AI -->
                <div class="flex justify-start">
                  <p class="max-w-[78%] rounded-2xl rounded-bl-md bg-white/10 px-3 py-2 text-sm text-white/90">
                    {dagang.demo.msg3}
                  </p>
                </div>

                <!-- stat row -->
                <div
                  class="mt-1 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-3.5 py-3"
                >
                  <span class="text-xs text-white/55">{dagang.demo.statLabel}</span>
                  <span class="font-serif text-lg text-white">{dagang.demo.statValue}</span>
                </div>

                <!-- input bar -->
                <div
                  class="mt-1 flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2.5"
                >
                  <span class="text-sm text-white/55">{dagang.demo.inputPlaceholder}</span>
                  <span class="ml-auto grid size-7 place-items-center rounded-full bg-white text-ink">
                    <HugeiconsIcon icon={ArrowUpRight01Icon} size={14} strokeWidth={2} />
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- ============ Upcoming slot ============ -->
    <div
      data-reveal
      style="--reveal-delay:120ms"
      class="mt-20 flex flex-wrap items-center justify-between gap-6 rounded-2xl border border-dashed border-white/20 bg-white/5 p-6 sm:mt-24 sm:p-8"
    >
      <div class="flex items-center gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-white/15 text-white">
          <HugeiconsIcon icon={PlusSignIcon} size={20} strokeWidth={1.8} />
        </span>
        <div>
          <p class="font-medium text-white">{upcoming.name}</p>
          <p class="text-sm text-white/55">{upcoming.status} &middot; {upcoming.desc}</p>
        </div>
      </div>
      <a
        href={upcoming.href}
        class="btn-glossy inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
      >
        {upcoming.cta}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</section>
