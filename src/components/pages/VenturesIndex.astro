---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon, PlusSignIcon, Tick02Icon } from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"
import { getSite } from "@/lib/site"
import { getPages } from "@/lib/pages"
import { resolveLang, detailPath, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const v = getSite(lang).ventures
const p = getPages(lang).ventures
---

<PageHero eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />

<section class="relative bg-paper py-16 sm:py-24">
  <div class="mx-auto max-w-5xl space-y-6 px-5 sm:px-8">
    {
      v.items.map((venture, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i * 100}ms`}
          class="rounded-3xl border border-hairline bg-background p-6 sm:p-9"
        >
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-sm text-muted-foreground">{venture.index}</span>
            {venture.slug === "dagangku-ai" ? (
              <DagangkuWordmark class="text-2xl text-ink" />
            ) : (
              <span class="font-serif text-2xl text-ink">{venture.name}</span>
            )}
            <span class="rounded-full border border-hairline px-3 py-1 text-xs text-muted-foreground">
              {venture.tag}
            </span>
          </div>

          <p class="mt-5 max-w-2xl text-lg leading-snug text-ink">{venture.headline.replace("\n", " ")}</p>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{venture.desc}</p>

          <ul class="mt-6 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
            {venture.features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-hairline text-ink">
                  <HugeiconsIcon icon={Tick02Icon} size={11} strokeWidth={2.2} />
                </span>
                <span class="text-sm text-muted-foreground">{feat}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7 grid max-w-md grid-cols-3 divide-x divide-hairline">
            {venture.proof.map((proof) => (
              <div class="px-4 first:pl-0">
                <div class="font-serif text-xl text-ink">{proof.value}</div>
                <div class="mt-0.5 text-xs text-muted-foreground">{proof.label}</div>
              </div>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={detailPath("ventures", lang, venture.slug)}
              class="btn-glossy inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
            >
              {p.openLabel}
              <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
            </a>
            <a
              href={venture.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-full border border-hairline px-5 text-sm font-medium text-ink transition-colors hover:border-ink/30"
            >
              {venture.domain}
              <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
            </a>
          </div>
        </article>
      ))
    }

    <!-- next venture -->
    <div
      data-reveal
      class="flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-dashed border-ink/20 bg-background p-6 sm:p-9"
    >
      <div class="flex items-start gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-hairline text-ink">
          <HugeiconsIcon icon={PlusSignIcon} size={20} strokeWidth={1.8} />
        </span>
        <div>
          <p class="font-serif text-xl text-ink">{p.upcoming.heading}</p>
          <p class="mt-1.5 max-w-lg text-sm leading-relaxed text-muted-foreground">
            {p.upcoming.body}
          </p>
        </div>
      </div>
      <a
        href={path("contact", lang)}
        class="btn-glossy inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
      >
        {p.upcoming.cta}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</section>
