---
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
const f = getSite(resolveLang(Astro.currentLocale)).faq
---

<section id="faq" class="relative overflow-hidden border-t border-hairline bg-background py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-x-16 gap-y-10 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div data-reveal class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow text-muted-foreground">{f.eyebrow}</p>
      <h2 class="t-heading mt-4 font-serif font-medium text-ink">
        {lines(f.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="mt-5 max-w-sm text-muted-foreground">
        {f.note}
        <a href="#kontak" class="link-underline font-medium text-ink">{f.noteLink}</a>
      </p>
    </div>

    <div data-reveal style="--reveal-delay:120ms" class="faq-list border-t border-hairline">
      {
        f.items.map((item, i) => {
          const open = i === 0
          return (
            <div class="faq-item border-b border-hairline">
              <button
                type="button"
                class="faq-trigger flex w-full items-center justify-between gap-6 py-5 text-left"
                aria-expanded={open ? "true" : "false"}
                aria-controls={`faq-panel-${i}`}
              >
                <span class="font-serif text-lg leading-snug text-ink sm:text-xl">{item.q}</span>
                <span class:list={["faq-icon grid size-9 shrink-0 place-items-center rounded-full border border-hairline text-ink", { "is-open": open }]}>
                  <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </span>
              </button>
              <div
                id={`faq-panel-${i}`}
                role="region"
                aria-hidden={open ? "false" : "true"}
                class:list={["faq-panel grid overflow-hidden", { "is-open": open }]}
              >
                <div class="min-h-0">
                  <p class="max-w-2xl pb-6 pr-10 text-[0.97rem] leading-relaxed text-muted-foreground">
                    {item.a}
                  </p>
                </div>
              </div>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .faq-panel {
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.5s ease;
  }
  .faq-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .faq-icon {
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .faq-icon.is-open {
    transform: rotate(45deg);
    background-color: var(--ink);
    color: var(--background);
    border-color: var(--ink);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".faq-list").forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".faq-item"))
    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger")
      const panel = item.querySelector<HTMLElement>(".faq-panel")
      const icon = item.querySelector<HTMLElement>(".faq-icon")
      if (!trigger || !panel || !icon) return
      trigger.addEventListener("click", () => {
        const willOpen = trigger.getAttribute("aria-expanded") !== "true"
        // accordion: close the others
        items.forEach((other) => {
          if (other === item) return
          other.querySelector(".faq-trigger")?.setAttribute("aria-expanded", "false")
          other.querySelector(".faq-panel")?.classList.remove("is-open")
          other.querySelector(".faq-panel")?.setAttribute("aria-hidden", "true")
          other.querySelector(".faq-icon")?.classList.remove("is-open")
        })
        trigger.setAttribute("aria-expanded", String(willOpen))
        panel.classList.toggle("is-open", willOpen)
        panel.setAttribute("aria-hidden", String(!willOpen))
        icon.classList.toggle("is-open", willOpen)
      })
    })
  })
</script>
