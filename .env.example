# Sanity CMS — powers /jurnal (blog) and /pers (press releases).
# Create a project at https://sanity.io/manage, then copy the values here into
# a local `.env` file. Until these are set the CMS-backed pages render their
# empty state and the rest of the site works normally.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Add http://localhost:4321 and https://dewataai.com as CORS origins in
# sanity.io/manage (with credentials allowed) so the embedded Studio at /admin
# can authenticate.
