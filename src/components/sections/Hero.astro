---
/**
 * Homepage, in the shape a holding company actually argues for itself: a
 * statement, the reasoning behind it, what it owns, what it has written, and
 * one line of contact. No feature grid, no stat tiles, no offer box. Those
 * belong on /kontak, where someone ready to talk goes looking.
 */
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"
import { getSite, lines } from "@/lib/site"
import { resolveLang, path, detailPath } from "@/lib/i18n"
import { listArticles, formatDate } from "@/lib/cms"

const lang = resolveLang(Astro.currentLocale)
const site = getSite(lang)
const h = site.hero
const legal = site.brand.legal

const posts = (await listArticles("post", lang)).slice(0, 3)
---

<section id="top" class="relative overflow-hidden bg-background pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-40 [mask-image:radial-gradient(ellipse_80%_45%_at_50%_0%,#000_35%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <p data-reveal class="eyebrow text-muted-foreground">{h.eyebrow}</p>

    <h1
      data-reveal
      style="--reveal-delay:80ms"
      class="t-display mt-8 max-w-4xl font-serif font-medium text-ink"
    >
      {lines(h.statement).map((line) => <span class="t-line">{line}</span>)}
    </h1>

    <!-- the argument -->
    <div class="mt-14 max-w-2xl space-y-6 sm:mt-20">
      {
        h.essay.map((para, i) => (
          <p
            data-reveal
            style={`--reveal-delay:${160 + i * 70}ms`}
            class="text-lg leading-[1.7] text-ink/75"
          >
            {para}
          </p>
        ))
      }
    </div>

    <p
      data-reveal
      class="mt-12 font-mono text-xs text-muted-foreground"
    >
      {legal.legalName} · Denpasar, Bali
    </p>
  </div>
</section>

<!-- what we own -->
<section id="ekosistem" class="border-t border-hairline bg-background py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div data-reveal class="flex items-baseline justify-between gap-6 border-b border-ink pb-3">
      <p class="eyebrow text-ink">{h.register.label}</p>
      <a
        href={path("ventures", lang)}
        class="link-underline font-mono text-xs text-muted-foreground transition-colors hover:text-ink"
      >
        {h.register.all}
      </a>
    </div>

    {
      site.ventures.items.map((venture, i) => (
        <a
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          href={detailPath("ventures", lang, venture.slug)}
          class="hold-row group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-hairline py-6 sm:items-center sm:gap-6"
        >
          <span class="font-mono text-sm text-muted-foreground tabular-nums">{venture.index}</span>

          <span class="min-w-0">
            {venture.slug === "dagangku-ai" ? (
              <DagangkuWordmark class="text-2xl text-ink sm:text-3xl" />
            ) : (
              <span class="font-serif text-2xl text-ink sm:text-3xl">{venture.name}</span>
            )}
            <span class="mt-1.5 block max-w-md text-sm leading-relaxed text-muted-foreground">
              {venture.desc}
            </span>
          </span>

          <span class="col-start-3 row-start-1 flex items-center gap-2 justify-self-end font-mono text-xs text-muted-foreground">
            <span class="size-1.5 rounded-full bg-ink" />
            {h.register.statusActive}
          </span>
        </a>
      ))
    }

    <a
      data-reveal
      href={path("contact", lang)}
      class="hold-row grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-hairline py-6 sm:items-center sm:gap-6"
    >
      <span class="font-mono text-sm text-ink/30 tabular-nums">03</span>
      <span class="min-w-0">
        <span class="hold-blank font-serif text-2xl text-ink/35 sm:text-3xl">
          {h.register.vacantName}
        </span>
        <span class="mt-1.5 block text-sm text-muted-foreground">{h.register.vacantNote}</span>
      </span>
      <span class="col-start-3 row-start-1 flex items-center gap-2 justify-self-end font-mono text-xs text-ink/40">
        <span class="size-1.5 rounded-full border border-ink/35" />
        {h.register.statusOpen}
      </span>
    </a>
  </div>
</section>

<!-- what we've written -->
<section class="bg-paper py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div data-reveal class="flex items-baseline justify-between gap-6 border-b border-ink pb-3">
      <p class="eyebrow text-ink">{h.writing.label}</p>
      <a
        href={path("journal", lang)}
        class="link-underline font-mono text-xs text-muted-foreground transition-colors hover:text-ink"
      >
        {h.writing.all}
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p data-reveal class="border-b border-hairline py-8 text-muted-foreground">
          {h.writing.empty}
        </p>
      ) : (
        posts.map((post, i) => (
          <a
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
            href={detailPath("journal", lang, post.slug)}
            class="hold-row group block border-b border-hairline py-6"
          >
            <span class="font-mono text-xs text-muted-foreground">
              {formatDate(post.publishedAt, lang)}
            </span>
            <span class="mt-2 block max-w-2xl font-serif text-xl leading-snug text-ink sm:text-2xl">
              {post.title}
            </span>
          </a>
        ))
      )
    }
  </div>
</section>

<!-- one line of contact -->
<section id="kontak" class="ink-section relative overflow-hidden py-20 sm:py-24">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="glow absolute top-[-40%] left-1/2 h-[420px] w-[760px] max-w-[120vw] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(255,255,255,0.06),transparent)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <p data-reveal class="t-heading-sm max-w-2xl font-serif text-white">{h.closing.line}</p>
    <a
      data-reveal
      style="--reveal-delay:90ms"
      href={path("contact", lang)}
      class="link-underline mt-8 inline-flex items-center gap-2 font-mono text-sm text-white/70 transition-colors hover:text-white"
    >
      {h.closing.cta}
      <HugeiconsIcon icon={ArrowUpRight01Icon} size={15} strokeWidth={1.8} />
    </a>
  </div>
</section>

<style>
  .hold-row {
    transition:
      background-color 0.3s ease,
      padding-left 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hold-row:hover,
  .hold-row:focus-visible {
    background-color: color-mix(in oklch, var(--foreground) 4%, transparent);
    padding-left: 0.75rem;
  }
  .hold-blank {
    padding-bottom: 0.15em;
    background-image: linear-gradient(
      to right,
      color-mix(in oklch, var(--foreground) 35%, transparent) 0 2px,
      transparent 2px 6px
    );
    background-repeat: repeat-x;
    background-position: 0 100%;
    background-size: 6px 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hold-row {
      transition: none;
    }
  }
</style>
