---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight01Icon,
  Linkedin01Icon,
  HammerIcon,
  RepeatIcon,
  Plant01Icon,
} from "@hugeicons/core-free-icons"
import PageHero from "@/components/PageHero.astro"
import { getSite, lines } from "@/lib/site"
import { getPages } from "@/lib/pages"
import { resolveLang, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const site = getSite(lang)
const p = getPages(lang).about
const legal = site.brand.legal

/** Build, run, grow — in the order the steps are authored. */
const STEP_ICONS = [HammerIcon, RepeatIcon, Plant01Icon]

const entityValues: Record<string, string> = {
  legalName: legal.legalName,
  legalForm: legal.legalForm,
  nib: legal.nib,
  address: legal.addressLine,
}
---

<PageHero eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />

<!-- operating model -->
<section class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{p.model.label}</p>
      <h2 class="t-heading-sm mt-4 font-serif text-ink">{p.model.heading}</h2>
    </div>

    <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-3">
      {
        p.model.steps.map((step, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`} class="border-t border-hairline pt-5">
            <div class="flex items-center justify-between">
              <span class="text-ink">
                <HugeiconsIcon icon={STEP_ICONS[i]} size={22} strokeWidth={1.3} />
              </span>
              <span class="font-mono text-sm text-muted-foreground">{step.index}</span>
            </div>
            <h3 class="mt-4 font-serif text-xl text-ink">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{step.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-hairline pt-10 sm:grid-cols-4">
      {
        site.about.facts.map((fact, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="font-serif text-2xl font-medium text-ink sm:text-3xl">{fact.value}</p>
            <p class="mt-1.5 text-sm text-muted-foreground">{fact.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- vision + mission -->
<section id="visi" class="scroll-mt-24 border-t border-hairline bg-paper pb-20 sm:pb-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div data-reveal class="grid gap-8 pt-16 sm:pt-20 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow text-muted-foreground">{site.vision.visionLabel}</p>
        <h2 class="t-heading-sm mt-4 max-w-md font-serif text-ink">
          {lines(site.vision.visionText).map((line) => <span class="t-line">{line}</span>)}
        </h2>
      </div>

      <div>
        <p class="eyebrow text-muted-foreground">{site.vision.missionLabel}</p>
        <ol class="mt-5">
          {
            site.vision.missionPoints.map((point, i) => (
              <li class="flex gap-5 border-t border-hairline py-4">
                <span class="font-mono text-sm text-muted-foreground tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="leading-relaxed text-muted-foreground">{point}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<!-- legal entity -->
<section class="ink-section relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-[0.3] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_45%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-5xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow text-white/55">{p.entity.label}</p>
      <h2 class="t-heading-sm mt-4 font-serif text-white">{p.entity.heading}</h2>
      <p class="mt-5 max-w-md leading-relaxed text-white/60">{p.entity.body}</p>

      <a
        href={legal.ahuUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glossy mt-8 inline-flex h-11 items-center gap-2 rounded-full px-5 text-sm font-medium"
      >
        {p.entity.certLabel}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>

    <dl data-reveal style="--reveal-delay:120ms" class="self-start">
      {
        p.entity.rows.map((row) => (
          <div class="grid gap-1 border-t border-white/10 py-4 sm:grid-cols-[0.5fr_1fr] sm:gap-6">
            <dt class="text-sm text-white/45">{row.label}</dt>
            <dd
              class:list={[
                "text-sm text-white/85",
                row.key === "nib" && "font-mono tracking-tight",
              ]}
            >
              {entityValues[row.key]}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

{
  p.team.members.length > 0 && (
    <section class="bg-background py-20 sm:py-28">
      <div class="mx-auto max-w-5xl px-5 sm:px-8">
        <div data-reveal class="max-w-2xl">
          <p class="eyebrow text-muted-foreground">{p.team.label}</p>
          <h2 class="t-heading-sm mt-4 font-serif text-ink">{p.team.heading}</h2>
          <p class="mt-5 leading-relaxed text-muted-foreground">{p.team.intro}</p>
        </div>

        <div
          class:list={[
            "mt-12 grid gap-6",
            p.team.members.length > 1 && "sm:grid-cols-2",
          ]}
        >
          {p.team.members.map((member, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
              class="flex flex-col gap-6 rounded-3xl border border-hairline bg-card p-6 sm:flex-row sm:items-start sm:gap-8 sm:p-8"
            >
              <span
                aria-hidden="true"
                class="grid size-16 shrink-0 place-items-center rounded-2xl bg-ink font-serif text-xl text-background"
              >
                {member.initials}
              </span>

              <div class="min-w-0">
                <p class="font-serif text-xl leading-snug text-ink sm:text-2xl">{member.name}</p>
                <p class="mt-1 text-sm text-muted-foreground">{member.role}</p>
                <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">{member.bio}</p>

                {member.linkedin && (
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline mt-5 inline-flex items-center gap-2 text-sm font-medium text-ink"
                  >
                    <HugeiconsIcon icon={Linkedin01Icon} size={15} strokeWidth={1.8} />
                    LinkedIn
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- questions, answered in full rather than hidden behind an accordion -->
<section id="faq" class="scroll-mt-24 border-t border-hairline bg-paper py-20 sm:py-28">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div data-reveal class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow text-muted-foreground">{site.faq.eyebrow}</p>
      <h2 class="t-heading-sm mt-4 font-serif text-ink">
        {lines(site.faq.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="mt-5 max-w-sm text-muted-foreground">
        {site.faq.note}
        <a href={path("contact", lang)} class="link-underline font-medium text-ink">
          {site.faq.noteLink}
        </a>
      </p>
    </div>

    <dl data-reveal style="--reveal-delay:120ms">
      {
        site.faq.items.map((item) => (
          <div class="border-t border-hairline py-6">
            <dt class="font-serif text-lg leading-snug text-ink sm:text-xl">{item.q}</dt>
            <dd class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
