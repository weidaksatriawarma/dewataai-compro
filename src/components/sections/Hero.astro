---
import DewataTechWordmark from "@/components/DewataTechWordmark.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import BrandMark from "@/components/BrandMark.astro"
import { getSite } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
import DagangkuWordmark from "@/components/DagangkuWordmark.astro"
const h = getSite(resolveLang(Astro.currentLocale)).hero
const d = h.demo
---

<section
  id="top"
  class="hero-shell relative isolate flex min-h-svh flex-col justify-center overflow-hidden bg-background pt-28 pb-14 sm:pt-32 sm:pb-16"
>
  <!-- backdrop layers -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 grid-overlay opacity-70 [mask-image:radial-gradient(ellipse_72%_56%_at_50%_0%,#000_55%,transparent_100%)]"
    >
    </div>
    <div
      class="glow absolute top-[-12%] left-1/2 h-[560px] w-[860px] max-w-[120vw] -translate-x-1/2 bg-[radial-gradient(closest-side,var(--glow-fg),transparent)]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-72 bg-gradient-to-b from-transparent to-muted/60"></div>
  </div>

  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p data-reveal class="flex justify-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-card/80 px-3.5 py-1.5"
      >
        <BrandMark class="size-3.5 text-ink" />
        <span class="eyebrow text-muted-foreground">{h.eyebrow}</span>
      </span>
    </p>

    <h1
      data-reveal
      style="--reveal-delay:90ms"
      class="t-display mt-7 font-serif font-medium text-ink"
    >
      <span class="t-line">{h.titleTop}</span>
      <span class="t-line">{h.titleAccent}</span>
    </h1>

    <p
      data-reveal
      style="--reveal-delay:210ms"
      class="hero-sub mx-auto mt-7 max-w-2xl text-base leading-relaxed text-balance text-muted-foreground sm:text-lg"
    >
      {h.sub}
    </p>

    <div
      data-reveal
      style="--reveal-delay:290ms"
      class="hero-cta mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href={h.ctaPrimary.href}
        class="btn-glossy inline-flex h-12 w-full items-center justify-center gap-2 rounded-full px-7 text-sm font-medium sm:w-auto"
      >
        {h.ctaPrimary.label}
        <HugeiconsIcon icon={ArrowUpRight01Icon} size={17} strokeWidth={2} />
      </a>
      <a
        href={h.ctaSecondary.href}
        class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-ink/15 bg-card/70 px-7 text-sm font-medium text-ink transition-colors hover:border-ink/30 hover:bg-card sm:w-auto"
      >
        {h.ctaSecondary.label}
      </a>
    </div>

  </div>

</section>

<!-- Group structure: the parent company and the ventures it owns. Kept out of
     the hero so the first screen carries the statement alone. The connector
     offsets (25% ∓ 5px) put the drop lines exactly on the centre of each card
     in the gap-5 two-column grid below. -->
<section id="struktur" class="relative bg-background pt-20 pb-20 sm:pt-28 sm:pb-28">
  <div data-reveal class="mx-auto max-w-4xl px-5 sm:px-8">
    <p class="eyebrow text-center text-muted-foreground">{d.eco}</p>

    <!-- parent -->
    <div class="mt-6 flex justify-center">
      <div
        class="inline-flex items-center gap-4 rounded-2xl border border-hairline bg-card px-6 py-5 shadow-[0_24px_60px_-36px_rgba(0,0,0,0.5)]"
      >
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-ink text-background">
          <BrandMark class="size-[19px]" />
        </span>
        <span class="text-left">
          <span class="block font-serif text-xl leading-tight text-ink">Dewata AI</span>
          <span class="block text-xs text-muted-foreground">{d.parentMeta}</span>
        </span>
      </div>
    </div>

    <!-- connector -->
    <div class="relative h-10 w-full sm:h-14" aria-hidden="true">
      <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-hairline sm:hidden"></span>
      <span class="absolute top-0 left-1/2 hidden h-7 w-px -translate-x-1/2 bg-hairline sm:block"></span>
      <span
        class="absolute top-7 right-[calc(25%-5px)] left-[calc(25%-5px)] hidden h-px bg-hairline sm:block"
      ></span>
      <span class="absolute top-7 left-[calc(25%-5px)] hidden h-7 w-px bg-hairline sm:block"></span>
      <span class="absolute top-7 right-[calc(25%-5px)] hidden h-7 w-px bg-hairline sm:block"></span>
    </div>

    <!-- ventures -->
    <div class="grid gap-5 sm:grid-cols-2">
      {
        [
          { name: "Dewata Tech", desc: d.techDesc, tag: d.webTag, domain: "dewatatech.com" },
          { name: null, desc: d.dagangDesc, tag: d.aiTag, domain: "dagangkuai.com" },
        ].map((venture) => (
          <a
            href={`https://${venture.domain}`}
            target="_blank"
            rel="noopener noreferrer"
            class="lift rounded-2xl border border-hairline bg-card p-6 transition-colors hover:border-ink/25"
          >
            <span class="flex items-center justify-between gap-3">
              {venture.name ? (
                <DewataTechWordmark class="text-base leading-none text-ink" />
              ) : (
                <DagangkuWordmark class="text-lg leading-none text-ink" />
              )}
              <span class="rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                {venture.tag}
              </span>
            </span>

            <span class="mt-2 block text-sm text-muted-foreground">{venture.desc}</span>

            <span class="mt-5 flex items-center gap-1.5 text-xs text-muted-foreground">
              <span class="size-1.5 rounded-full bg-ink" />
              {d.active}
              <span class="ml-auto inline-flex items-center gap-1 font-medium text-ink">
                {venture.domain}
                <HugeiconsIcon icon={ArrowUpRight01Icon} size={13} strokeWidth={2} />
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Mobile landscape has almost no vertical room. Rather than let the taglines
     fall out of the first screen, the hero drops the viewport minimum and
     tightens its own rhythm. */
  @media (orientation: landscape) and (max-height: 600px) {
    .hero-shell {
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }
    .hero-shell .hero-sub {
      margin-top: 0.85rem;
    }
    .hero-shell .hero-cta {
      margin-top: 1.1rem;
    }
  }
</style>
