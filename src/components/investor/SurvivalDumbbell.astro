---
/**
 * Raw outcome against survival-weighted outcome, one row per asset.
 *
 * A dumbbell is the right form because the reader's job is before-and-after per
 * item, not magnitude across items: the length of each bar is the size of the
 * haircut, and the filled dot is the number we actually believe. The x axis is
 * logarithmic for the same reason as the curve chart, otherwise the two
 * property rows collapse into the left margin.
 *
 * The point of the figure is that the filled dots are in a different order than
 * the hollow ones.
 */
import {
  ASSETS,
  INDEX,
  HORIZON,
  SURVIVAL,
  BASE_INDEX,
  weighted,
  multiple,
  strokeColor,
  type AssetKey,
} from "@/lib/horizon"

interface Props {
  assets: Record<AssetKey, string>
  labels: { rawLabel: string; weightedLabel: string; survivalLabel: string }
  lang: "id" | "en"
}

const { assets, labels, lang } = Astro.props

const W = 780
const ROW = 84
const L = 0
const R = 96
/* The axis needs a band of its own under the last row. Sharing that space with
   the last row's note put the tick labels straight through it. */
const AXIS = 34
const H = ASSETS.length * ROW + AXIS

const rows = ASSETS.map((key) => ({
  key,
  raw: INDEX[key][HORIZON] / BASE_INDEX,
  cut: weighted(key, HORIZON) / BASE_INDEX,
  survival: SURVIVAL[key],
}))

/* The domain is set wider than the ticks so no dot lands on the frame. It has
   to reach below 1x: weighted for survival, a cafe comes out at roughly the
   money that went in, and that row is the point of the figure. */
const DOMAIN: [number, number] = [0.6, 700]
const TICKS = [1, 5, 10, 50, 100, 500]
const lo = Math.log10(DOMAIN[0])
const hi = Math.log10(DOMAIN[1])
const px = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo)) * (W - L - R)

const locale = lang === "en" ? "en-US" : "id-ID"
/* Values share the page's own formatter so a row and its table cell can never
   print the same number to different precisions. Axis ticks stay bare. */
const mult = (v: number) => `${multiple(v * BASE_INDEX, lang)}x`
const tick = (v: number) =>
  `${new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(v)}x`
const pct = (v: number) => `${Math.round(v * 100)}%`
---

<div>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="h-auto w-full"
    role="img"
    aria-label={rows
      .map((r) => `${assets[r.key]}: ${mult(r.raw)} ${mult(r.cut)}`)
      .join(". ")}
  >
    {
      TICKS.map((t) => (
        <g>
          <line x1={px(t)} y1="0" x2={px(t)} y2={H - AXIS} class="grid" />
          <text x={px(t)} y={H - 10} text-anchor="middle" class="tick">
            {tick(t)}
          </text>
        </g>
      ))
    }

    {
      rows.map((r, i) => {
        const y = i * ROW + 42
        return (
          <g>
            <title>{`${assets[r.key]}: ${labels.rawLabel} ${mult(r.raw)}, ${labels.weightedLabel} ${mult(r.cut)}`}</title>
            <text x="0" y={y - 20} class="lab">
              {assets[r.key]}
            </text>
            <line x1={px(r.cut)} y1={y} x2={px(r.raw)} y2={y} class="bar" />
            <circle
              cx={px(r.raw)}
              cy={y}
              r="7"
              fill="var(--background)"
              stroke={strokeColor(r.key)}
              stroke-width="2"
            />
            <circle
              cx={px(r.cut)}
              cy={y}
              r="7"
              fill={strokeColor(r.key)}
              stroke="var(--background)"
              stroke-width="2"
            />
            <text x={W - R + 12} y={y + 5} class="val">
              {mult(r.cut)}
            </text>
            <text x="0" y={y + 28} class="note">
              {labels.survivalLabel} {pct(r.survival)} · {labels.rawLabel}{" "}
              {mult(r.raw)}
            </text>
            <line
              x1="0"
              y1={y + ROW - 42}
              x2={W}
              y2={y + ROW - 42}
              class="rule"
            />
          </g>
        )
      })
    }
  </svg>

  <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
    <li class="flex items-center gap-2.5">
      <span
        class="size-3.5 shrink-0 rounded-full border-2 border-ink bg-background"
      ></span>
      <span class="text-xs text-muted-foreground">{labels.rawLabel}</span>
    </li>
    <li class="flex items-center gap-2.5">
      <span class="size-3.5 shrink-0 rounded-full bg-ink"></span>
      <span class="text-xs text-muted-foreground">{labels.weightedLabel}</span>
    </li>
  </ul>
</div>

<style>
  .grid {
    stroke: var(--hairline);
    stroke-width: 1;
  }
  .tick {
    fill: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .lab {
    fill: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }
  .val {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .note {
    fill: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .bar {
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0.35;
  }
  .rule {
    stroke: var(--hairline);
    stroke-width: 1;
  }
</style>
