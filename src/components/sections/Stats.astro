---
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"
const s = getSite(resolveLang(Astro.currentLocale)).stats
---

<section class="relative overflow-hidden bg-background py-24 sm:py-32">
  <!-- backdrop texture -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 dot-overlay opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_50%,#000_40%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- header -->
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-muted-foreground">{s.eyebrow}</p>
      <h2
        class="t-heading mt-4 font-serif font-medium text-ink"
      >
        {lines(s.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
    </div>

    <!-- stats row -->
    <div
      data-reveal
      style="--reveal-delay:120ms"
      class="mt-14 grid grid-cols-2 overflow-hidden rounded-3xl border border-hairline bg-card/60 lg:grid-cols-4"
    >
      {
        s.items.map((item, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${160 + i * 80}ms`}
            class="border-hairline p-6 sm:p-8 [&:nth-child(n+3)]:border-t [&:nth-child(even)]:border-l lg:[&:nth-child(n+2)]:border-l lg:[&:nth-child(n+3)]:border-t-0"
          >
            <p class="flex items-baseline gap-0.5 whitespace-nowrap font-serif font-medium tracking-[-0.01em] text-ink">
              <span class="text-4xl sm:text-6xl">{item.value}</span>
              {item.unit && (
                <span class="text-2xl text-muted-foreground">{item.unit}</span>
              )}
            </p>
            <p class="mt-3 font-medium text-ink">{item.label}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
