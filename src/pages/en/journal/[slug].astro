---
// Rendered on demand: a post published in Sanity is live on the next request,
// no rebuild required.
export const prerender = false

import PageLayout from "@/layouts/page.astro"
import ArticleDetail from "@/components/pages/ArticleDetail.astro"
import NotFound from "@/components/pages/NotFound.astro"
import { getArticle, imageUrl } from "@/lib/cms"
import { getPages } from "@/lib/pages"
import { articlePageProps } from "@/lib/schema"

const slug = Astro.params.slug!
const article = await getArticle("post", "en", slug)

// A slug that resolves to nothing is a 404, not a server error. Rewriting to
// /404 is not an option here: that route is prerendered, and Astro refuses to
// rewrite an on-demand route with a static one, which would make every missing
// article a 500 and put a server error in Search Console.
if (!article) Astro.response.status = 404

// Canonical, hreflang, share card, article timestamps and structured data.
const head = article
  ? articlePageProps({
      kind: "post",
      lang: "en",
      article,
      image: imageUrl(article.coverImage, 1200),
      sectionName: getPages("en").journal.eyebrow,
    })
  : { pathId: null, pathEn: null, noindex: true }
---

<PageLayout
  title={article ? `${article.title} | Dewata AI Journal` : "404 | Dewata AI"}
  description={article?.excerpt}
  {...head}
>
  {article ? <ArticleDetail kind="post" article={article} /> : <NotFound />}
</PageLayout>
