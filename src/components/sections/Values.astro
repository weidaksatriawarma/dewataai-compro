---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Location01Icon,
  Target01Icon,
  Shield01Icon,
  SparklesIcon,
} from "@hugeicons/core-free-icons"
import { getSite, lines } from "@/lib/site"
import { resolveLang } from "@/lib/i18n"

const v = getSite(resolveLang(Astro.currentLocale)).values

const ICONS = {
  local: Location01Icon,
  practical: Target01Icon,
  trust: Shield01Icon,
  craft: SparklesIcon,
} as const
---

<section id="nilai" class="relative overflow-hidden bg-paper py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="eyebrow text-muted-foreground">{v.eyebrow}</p>
      <h2 class="t-heading mt-4 font-serif font-medium text-ink">
        {lines(v.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        v.items.map((item, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${80 + i * 80}ms`}
            class="lift rounded-2xl border border-hairline bg-background p-6"
          >
            <span class="grid size-12 place-items-center rounded-xl border border-hairline text-ink">
              <HugeiconsIcon
                icon={ICONS[item.key]}
                size={22}
                strokeWidth={1.6}
              />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
