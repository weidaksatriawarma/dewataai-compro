---
/**
 * The leverage case.
 *
 * Layout takes the defence-industrial reference the brief asked for: stacked
 * full-bleed slabs, one idea per band, a lot of air. Type does not: headings
 * stay on the site's serif display and the shared `t-*` scale, so the page
 * reads as the same company as the homepage rather than a visiting brand.
 */
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowRight01Icon,
  ArrowDown01Icon,
  Database01Icon,
  GroupLayersIcon,
  Store01Icon,
  Hotel01Icon,
  Restaurant01Icon,
  BankIcon,
  Cash01Icon,
  Analytics01Icon,
} from "@hugeicons/core-free-icons"
import PlaceholderImage from "@/components/PlaceholderImage.astro"
import Figure from "@/components/investor/Figure.astro"
import CapitalBars from "@/components/investor/CapitalBars.astro"
import CostShare from "@/components/investor/CostShare.astro"
import CeilingChart from "@/components/investor/CeilingChart.astro"
import { lines } from "@/lib/site"
import { images } from "@/lib/images"
import {
  getInvestor,
  CAPITAL_TO_SCALE,
  COST_SHARE,
  COST_SHARE_SCHEMA,
  CAPACITY_CURVE,
  rupiahShort,
} from "@/lib/investor"
import { resolveLang, path } from "@/lib/i18n"

const lang = resolveLang(Astro.currentLocale)
const p = getInvestor(lang).investor
const fig = p.figure

/* Icon order matches the copy arrays in lib/investor.ts. */
const RECORD_ICONS = [Database01Icon, GroupLayersIcon, Store01Icon]
const FAIR_ICONS = [Hotel01Icon, BankIcon, Cash01Icon, Analytics01Icon]

/* ---- figure 01: capital ---- */
const capitalBars = CAPITAL_TO_SCALE.map((row) => ({
  label: p.capital.chart.items[row.key],
  note: p.capital.chart.notes[row.key],
  display: rupiahShort(row.value, lang, p.capital.chart.units),
  value: row.value,
  kind: row.key === "software" ? ("software" as const) : ("physical" as const),
}))
const capitalRows = capitalBars.map((b) => [b.label, b.display, b.note])

/* ---- figure 02: cost share ---- */
const shareKeys = ["villa", "resto", "software"] as const
const shareColumns = shareKeys.map((key) => ({
  label: p.share.chart.columns[key],
  segments: COST_SHARE_SCHEMA.map((seg) => ({
    key: seg,
    label: p.share.chart.segments[seg],
    value: COST_SHARE[key][seg],
  })),
}))
const shareRows = COST_SHARE_SCHEMA.map((seg) => [
  p.share.chart.segments[seg],
  `${COST_SHARE.villa[seg]}%`,
  `${COST_SHARE.resto[seg]}%`,
  `${COST_SHARE.software[seg]}%`,
])

/* ---- figure 03: ceiling ---- */
const ceilingRows = CAPACITY_CURVE.filter((row) => row.x % 50 === 0).map((row) => [
  String(row.x),
  String(row.physical),
  String(row.software),
])

/* The three businesses the whole page compares, shown once so the columns of
   the cost chart have a face. */
const compare = [
  { src: images.compareVilla, seed: "villa", icon: Hotel01Icon, label: p.share.chart.columns.villa },
  { src: images.compareResto, seed: "resto", icon: Restaurant01Icon, label: p.share.chart.columns.resto },
  {
    src: images.compareSoftware,
    seed: "software",
    icon: Analytics01Icon,
    label: p.share.chart.columns.software,
  },
]

const slab = "border-b border-hairline"
const wrap = "mx-auto w-full max-w-7xl px-6 sm:px-10"
const chip = "grid size-10 shrink-0 place-items-center rounded-xl border border-hairline bg-muted text-ink"
const chipDark = "grid size-10 shrink-0 place-items-center rounded-xl border border-white/15 bg-white/[0.06] text-white"
---

<!-- hero -->
<section class="ink-section relative flex min-h-[78vh] flex-col justify-between overflow-hidden">
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <PlaceholderImage
      src={images.investorHero}
      alt=""
      seed="investor-hero"
      loading="eager"
      class="opacity-[0.38]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(10,10,10,0.42),rgba(10,10,10,0.9))]">
    </div>
    <div
      class="absolute inset-0 grid-overlay opacity-20 [mask-image:linear-gradient(to_bottom,#000_10%,transparent_85%)]"
    >
    </div>
  </div>

  <div class={`relative z-10 ${wrap} pt-32 sm:pt-40`}>
    <p class="eyebrow text-white/50">{p.eyebrow}</p>
  </div>

  <div class={`relative z-10 ${wrap} pb-16 sm:pb-24`}>
    <h1 class="t-display max-w-5xl font-serif font-medium text-white">
      {lines(p.heading).map((line) => <span class="t-line">{line}</span>)}
    </h1>
    <div class="mt-12 grid gap-8 border-t border-white/12 pt-8 lg:grid-cols-[0.55fr_0.45fr]">
      <p class="max-w-2xl leading-relaxed text-white/65">{p.lead}</p>
      <p class="font-mono text-[0.7rem] leading-relaxed tracking-[0.06em] text-white/40 lg:text-right">
        {p.meta_}
      </p>
    </div>
  </div>

  <span class="pointer-events-none absolute right-6 bottom-8 z-10 text-white/30 sm:right-10">
    <HugeiconsIcon icon={ArrowDown01Icon} size={22} strokeWidth={1.5} />
  </span>
</section>

<!-- the one sentence -->
<section class={`bg-paper py-28 sm:py-44 ${slab}`}>
  <div class={wrap}>
    <p class="t-display text-center font-serif font-medium text-ink">
      {lines(p.statement).map((line) => <span class="t-line">{line}</span>)}
    </p>
  </div>
</section>

<!-- the short version, with the three businesses being compared -->
<section class={`bg-background py-24 sm:py-32 ${slab}`}>
  <div class={wrap}>
    <div class="grid gap-10 lg:grid-cols-[0.45fr_0.55fr] lg:gap-16">
      <div>
        <p class="eyebrow text-muted-foreground">{p.thesis.label}</p>
        <h2 class="t-heading-sm mt-6 font-serif font-medium text-ink">
          {lines(p.thesis.heading).map((line) => <span class="t-line">{line}</span>)}
        </h2>
      </div>
      <div class="space-y-5 self-end">
        {p.thesis.body.map((para) => <p class="leading-relaxed text-muted-foreground">{para}</p>)}
      </div>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-3">
      {
        compare.map((item, i) => (
          <figure data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="aspect-[4/3] overflow-hidden border border-hairline">
              <PlaceholderImage src={item.src} alt={item.label} seed={item.seed} />
            </div>
            <figcaption class="mt-3 flex items-center gap-2.5 text-sm text-ink">
              <HugeiconsIcon icon={item.icon} size={17} strokeWidth={1.7} />
              {item.label}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<!-- how we think about data -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <div class="grid gap-10 lg:grid-cols-[0.34fr_0.66fr] lg:gap-16">
      <div>
        <p class="eyebrow text-muted-foreground">{p.record.label}</p>
        <h2 class="t-heading mt-6 font-serif font-medium text-ink">
          {lines(p.record.heading).map((line) => <span class="t-line">{line}</span>)}
        </h2>
      </div>
      <p class="max-w-2xl self-end leading-relaxed text-muted-foreground">{p.record.sub}</p>
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-3">
      {
        p.record.items.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="border-t border-ink pt-6">
            <div class="flex items-center gap-3">
              <span class={chip}>
                <HugeiconsIcon icon={RECORD_ICONS[i]} size={19} strokeWidth={1.7} />
              </span>
              <span class="font-mono text-xs tracking-[0.2em] text-muted-foreground">
                {item.index}
              </span>
            </div>
            <h3 class="mt-5 font-serif text-xl leading-snug text-ink">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 02 capital -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.capital.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.capital.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.capital.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="01"
        prefix={fig.prefix}
        title={p.capital.chart.title}
        unit={p.capital.chart.unit}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.capital.chart.tableHeaders}
        rows={capitalRows}
      >
        <CapitalBars
          bars={capitalBars}
          legend={{
            physical: `${p.capital.chart.items.villa} / ${p.capital.chart.items.resto}`,
            software: p.capital.chart.items.software,
          }}
        />
      </Figure>
    </div>

    <p class="mt-10 max-w-3xl leading-relaxed text-muted-foreground">{p.capital.after}</p>
  </div>
</section>

<!-- 03 cost structure -->
<section class={`bg-paper py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.share.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.share.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.share.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="02"
        prefix={fig.prefix}
        title={p.share.chart.title}
        unit={p.share.chart.unit}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.share.chart.tableHeaders}
        rows={shareRows}
      >
        <CostShare columns={shareColumns} order={COST_SHARE_SCHEMA} />
      </Figure>
    </div>

    <p class="mt-10 max-w-3xl leading-relaxed text-muted-foreground">{p.share.after}</p>
  </div>
</section>

<!-- 04 ceiling -->
<section class={`bg-background py-24 sm:py-36 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.ceiling.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-ink">
        {lines(p.ceiling.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-muted-foreground">{p.ceiling.sub}</p>
    </div>

    <div class="mt-14">
      <Figure
        index="03"
        prefix={fig.prefix}
        title={p.ceiling.chart.title}
        status={fig.status}
        statusTitle={fig.statusTitle}
        tableLabel={fig.table}
        headers={p.ceiling.chart.tableHeaders}
        rows={ceilingRows}
      >
        <CeilingChart labels={p.ceiling.chart} />
      </Figure>
    </div>

    <p class="mt-10 max-w-3xl leading-relaxed text-muted-foreground">{p.ceiling.after}</p>
  </div>
</section>

<!-- 05 the fair part -->
<section class="ink-section py-24 sm:py-36">
  <div class={wrap}>
    <p class="eyebrow text-white/50">{p.fair.label}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.55fr_0.45fr] lg:items-end lg:gap-16">
      <h2 class="t-heading font-serif font-medium text-white">
        {lines(p.fair.heading).map((line) => <span class="t-line">{line}</span>)}
      </h2>
      <p class="leading-relaxed text-white/60">{p.fair.sub}</p>
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-2">
      {
        p.fair.items.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`} class="border-t border-white/25 pt-6">
            <span class={chipDark}>
              <HugeiconsIcon icon={FAIR_ICONS[i]} size={19} strokeWidth={1.7} />
            </span>
            <h3 class="mt-5 font-serif text-xl leading-snug text-white">{item.title}</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-white/60">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- assumptions -->
<section class={`bg-background py-24 sm:py-32 ${slab}`}>
  <div class={wrap}>
    <div class="grid gap-6 lg:grid-cols-[0.34fr_0.66fr] lg:gap-16">
      <div>
        <p class="eyebrow text-muted-foreground">{p.assumptions.label}</p>
        <h2 class="t-heading-sm mt-6 font-serif font-medium text-ink">
          {p.assumptions.heading}
        </h2>
      </div>
      <p class="max-w-2xl self-end leading-relaxed text-muted-foreground">{p.assumptions.sub}</p>
    </div>

    <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-3">
      {
        p.assumptions.groups.map((group) => (
          <div class="border-t border-hairline pt-5">
            <h3 class="text-sm font-medium text-ink">{group.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {group.items.map((item) => (
                <li class="font-mono text-[0.72rem] leading-relaxed text-muted-foreground">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-12 max-w-3xl border-t border-hairline pt-6 leading-relaxed text-muted-foreground">
      {p.assumptions.note}
    </p>
  </div>
</section>

<!-- legal -->
<section class={`bg-paper py-14 ${slab}`}>
  <div class={wrap}>
    <p class="eyebrow text-muted-foreground">{p.legal.label}</p>
    <ul class="mt-4 grid gap-2.5 sm:grid-cols-3 sm:gap-8">
      {
        p.legal.items.map((item) => (
          <li class="max-w-md text-xs leading-relaxed text-muted-foreground">{item}</li>
        ))
      }
    </ul>
  </div>
</section>

<!-- cta -->
<section class="ink-section py-24 sm:py-32">
  <div class={wrap}>
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-xl">
        <h2 class="t-heading-sm font-serif font-medium text-white">{p.cta.heading}</h2>
        <p class="mt-4 leading-relaxed text-white/60">{p.cta.body}</p>
      </div>
      <a
        href={path("contact", lang)}
        class="btn-glossy inline-flex h-12 items-center gap-2 rounded-full px-6 text-sm font-medium"
      >
        {p.cta.label}
        <HugeiconsIcon icon={ArrowRight01Icon} size={16} strokeWidth={2} />
      </a>
    </div>

    <a
      href={p.next.href}
      class="mt-14 flex items-center justify-between gap-6 border-t border-white/15 pt-6 text-white/70 transition-colors hover:text-white"
    >
      <span class="font-serif text-lg">{p.next.label}</span>
      <HugeiconsIcon icon={ArrowRight01Icon} size={20} strokeWidth={1.8} />
    </a>
  </div>
</section>
